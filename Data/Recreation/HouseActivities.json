        "memberTypes": [
            {
                "_comment": "A home's family doctor - assigned by the player in the management job-post tab (sharedAssignableMemberTypes - every faction). Replaces the character's MemberType there (user 2026-11-01: accepted - e.g. Utnapishtim's student types and their relationship fallback are lost while doctor). Only assignable while the faction has an examination bed and a chemistry workbench in a non-private room and the character passes the placeholder check (skill_social >= 1); how hard that furniture is to get keeps it where it belongs. No schedule of its own - the doctor sandboxes like everyone; it PROVIDES the physical checkup the other members book on their own (providedActivities; the doctor is the activity's required 'provider' role). A clinic's doctor type would provide the same activity (same cooldownTag). legacyIDs: the former Utnapishtim-only type.",
                "ID": "membertype_family_doctor",
                "legacyIDs": [ "membertype_ba_family_doctor" ],

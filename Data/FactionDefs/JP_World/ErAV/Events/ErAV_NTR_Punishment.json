                    "chara_conditions": [
                        { "parameters": [ "exists" ] }
                    ]
                },
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "line": "erav_ntr_punishment_kick_failed",
                        "tooltip": "target character: $target.name$",
                        "Results": [
                            { "Type": "StartEventChain", "arguments": [ "erav_ntr_punishment", "erav_ntr_punishment_select", "3", "10" ] }
                        ],
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "payee",
                        "_comment": "Kiryu-gumi side firing - the payee variant of the same notice (display gated by its own visibility, same as OnDebtFailed's payee entry). Must NOT start the chain a second time on the payee's self.",
                        "line": "erav_ntr_punishment_kick_failed_payee",
                        "tooltip": "target character: $target.name$",
                        "isLast": true
                    }
                ]
            },
            {
                "ID": "erav_ntr_punishment_select",
                "_comment": "Payer flow: notice -> check_candidates branch -> select question (per-candidate options + greyed player option) -> farewell kojo -> departure + StartEvent. no_candidates is a placeholder for draft branch D (Kanon self-sacrifice) - TODO. The draft's pay-by-selling-something escape option (player choice = 1) is intentionally not implemented yet - TODO.",
                "UISpec": { "displayMode": "AVG" },
                "SelfValidator": {
                    "chara_conditions": [
                        { "parameters": [ "exists" ] }
                    ]
                },

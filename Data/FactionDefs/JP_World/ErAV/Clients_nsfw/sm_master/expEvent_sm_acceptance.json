                                    { "Type": "CopyTargets", "arguments": ["client", "enemy"] },
                                    { "Type": "MoveToTargetRoom", "arguments": ["enemy", "party"] },
                                    { "Type": "JumpToLabel", "arguments": ["", "scene"] }
                                ]
                            },
                            {
                                "option": "_error",
                                "Results": [
                                    { "Type": "JumpToLabel", "arguments": ["", "error"] }

{
    "_doc": "sm_master/acceptance: neutral interactive writer skeleton. Major weight 1, party-wide cooldown 24 hours, exactly one female participant. Existing actor roles and COM IDs retained; one validated AP per phase, with separate preparation and AP success/failure branches. Full/first-only (where available)/skip choices differ in executed APs and final banked summary. No guaranteed physiological outcomes. Every ending redresses, returns all borrowed scopes, and resolves. Legacy dictionary keys retained as placeholders. No chronological order assumed.",
    "ExplorationEvents": {
        "list": [
            {
                "eventID": "exp_event_erav_sm_acceptance",
                "eventString_Ongoing": "exp_event_erav_sm_acceptance_ongoing",
                "DurationMinutes": 90,
                "teamRequirement": {
                    "minTeamCount": 1,
                    "allowPrisoner": true,
                    "requireCombat": false,
                    "maxTeamCount": 1,
                    "strictPartyCount": true,
                    "charaReq_Select": {
                        "requireFemale": true
                    }
                },
                "baseWeight": 1,
                "possibleResults": [
                    {
                        "baseWeight": 1,
                        "resultText": "exp_event_erav_sm_acceptance_result",
                        "eventID": "event_erav_sm_acceptance"
                    }
                ],
                "cooldownHours": 24
            }
        ]
    },
    "Events": {
        "list": [
            {
                "ID": "event_erav_sm_acceptance",
                "showEventHeader": "event_erav_sm_acceptance_writer_header",
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "start",
                        "options": [

                                    { "Type": "JumpToLabel", "arguments": ["", "skipped"] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "phase_1_prepare",
                        "options": [
                            {
                                "option": "_prepare",
                                "Results": [
                                    { "Type": "Undress", "arguments": ["party", "None", "SeeThrough", "true"] },
                                    { "Type": "Undress", "arguments": ["enemy", "None", "SeeThrough", "true"] },
                                    { "Type": "JumpToLabel", "arguments": ["", "phase_1_execute"] }

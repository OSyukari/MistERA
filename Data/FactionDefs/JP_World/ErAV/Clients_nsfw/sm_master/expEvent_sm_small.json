                "ID": "event_erav_sm_small_check",
                "_comment": "Hidden (runImmediate): empty lines only, no flush. self = player, party = the victim.",
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",

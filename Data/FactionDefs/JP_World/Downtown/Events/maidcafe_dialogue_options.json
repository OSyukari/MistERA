{
    "_comment": "SunMart fetch-options / ask / callback pattern. Generated options retain disabled candidates and handler tooltips. The always-staffed maid can hire for both duties; NPC-only coverage never appears among selectable shifts.",
    "Events": { "list": [
        {
            "ID": "jp_maid_cafe_Opt_Apply", "trigger": "OnDialogue_Options", "allowDuplicate": false, "UISpec": { "displayMode": "AVG" },
            "SelfValidator": { "chara_conditions": [{ "parameters": ["exists"] }, { "parameters": ["isPlayer"] }] },
            "TargetValidators": [{ "refkeys": ["staff"], "baseScope": "CurrentTarget", "minTargetCount": 1, "chara_conditions": [{ "parameters": ["exists"] }, { "parameters": ["excludePlayer"] }, { "parameters": ["isConscious"] }, { "parameters": ["isActiveFaction", "jp_cosplay_cafe"] }, { "parameters": ["hasActorTag", "jp_maid_cafe_hiring"] }] }],
            "events": [
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "line": "otaku_apply_greeting", "Results": [{ "Type": "JoinActiveFaction", "arguments": ["applyOptions", "selfAndFollowers", "staff", "membertype_otaku_maid_parttime", "applyError"] }] },
                { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "options": [{ "option": "options", "Results": [{ "Type": "ExistStoredOptions", "arguments": ["applyOptions"] }, { "Type": "JumpToLabel", "arguments": ["", "ask"] }] }, { "option": "error", "Results": [{ "Type": "JumpToLabel", "arguments": ["", "error"] }] }] },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "error", "line": "$applyError$", "isLast": true },
                { "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp", "label": "ask", "question": "otaku_apply_question", "loadOptionsKey": "applyOptions", "loadOptionsResults": [{ "Type": "JumpToLabel", "arguments": ["", "done"] }], "options": [{ "option": "otaku_staff_cancel", "isDefaultCancel": true, "Results": [{ "Type": "JumpToLabel", "arguments": ["", "cancel"] }] }] },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "done", "line": "otaku_apply_done" },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "line": "$factionChangeString$", "isLast": true },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "cancel", "line": "otaku_staff_cancelLine", "isLast": true }
            ]
        },
        {
            "ID": "jp_maid_cafe_Opt_ApplyKitchen", "trigger": "OnDialogue_Options", "allowDuplicate": false, "UISpec": { "displayMode": "AVG" },
            "SelfValidator": { "chara_conditions": [{ "parameters": ["exists"] }, { "parameters": ["isPlayer"] }] },
            "TargetValidators": [{ "refkeys": ["staff"], "baseScope": "CurrentTarget", "minTargetCount": 1, "chara_conditions": [{ "parameters": ["exists"] }, { "parameters": ["excludePlayer"] }, { "parameters": ["isConscious"] }, { "parameters": ["isActiveFaction", "jp_cosplay_cafe"] }, { "parameters": ["hasActorTag", "jp_maid_cafe_hiring"] }] }],
            "events": [
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "line": "otaku_apply_greeting", "Results": [{ "Type": "JoinActiveFaction", "arguments": ["applyOptions", "selfAndFollowers", "staff", "membertype_otaku_kitchen", "applyError"] }] },
                { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "options": [{ "option": "options", "Results": [{ "Type": "ExistStoredOptions", "arguments": ["applyOptions"] }, { "Type": "JumpToLabel", "arguments": ["", "ask"] }] }, { "option": "error", "Results": [{ "Type": "JumpToLabel", "arguments": ["", "error"] }] }] },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "error", "line": "$applyError$", "isLast": true },
                { "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp", "label": "ask", "question": "otaku_apply_question", "loadOptionsKey": "applyOptions", "loadOptionsResults": [{ "Type": "JumpToLabel", "arguments": ["", "done"] }], "options": [{ "option": "otaku_staff_cancel", "isDefaultCancel": true, "Results": [{ "Type": "JumpToLabel", "arguments": ["", "cancel"] }] }] },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "done", "line": "otaku_apply_done" },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "line": "$factionChangeString$", "isLast": true },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "cancel", "line": "otaku_staff_cancelLine", "isLast": true }
            ]
        },
        {
            "ID": "jp_maid_cafe_Opt_Quit", "trigger": "OnDialogue_Options", "allowDuplicate": false, "UISpec": { "displayMode": "AVG", "infoDisplay": "Hide" },
            "SelfValidator": { "chara_conditions": [{ "parameters": ["exists"] }, { "parameters": ["isPlayer"] }] },
            "TargetValidators": [
                { "refkeys": ["staff"], "baseScope": "CurrentTarget", "minTargetCount": 1, "chara_conditions": [{ "parameters": ["exists"] }, { "parameters": ["excludePlayer"] }, { "parameters": ["isConscious"] }, { "parameters": ["isActiveFaction", "jp_cosplay_cafe"] }, { "parameters": ["hasActorTag", "jp_maid_cafe_hiring"] }] },
                { "refkeys": ["leavers"], "baseScope": "FactionMembersWithMemberType", "extraScopeArguments": ["jp_cosplay_cafe", "membertype_otaku_maid_staff"], "minTargetCount": 1, "chara_conditions": [{ "parameters": ["exists"] }, { "parameters": ["sharesHomeFaction"] }] }
            ],
            "events": [
                { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "options": [{ "option": "build", "Results": [{ "Type": "LeaveActiveFaction", "arguments": ["quitOptions", "leavers", "staff", "membertype_otaku_maid_staff"] }, { "Type": "JumpToLabel", "arguments": ["", "ask"] }] }] },
                { "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp", "label": "ask", "question": "otaku_quit_question", "loadOptionsKey": "quitOptions", "loadOptionsResults": [{ "Type": "JumpToLabel", "arguments": ["", "done"] }], "options": [{ "option": "otaku_staff_cancel", "isDefaultCancel": true, "Results": [{ "Type": "JumpToLabel", "arguments": ["", "cancel"] }] }] },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "done", "line": "otaku_quit_done" },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "line": "$factionChangeString$", "isLast": true },
                { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "cancel", "line": "otaku_staff_cancelLine", "isLast": true }
            ]
        }
    ] },
    "Dictionary": { "Entries": { "zh-cn": {
        "jp_maid_cafe_Opt_Apply": "应聘女仆兼职", "jp_maid_cafe_Opt_ApplyKitchen": "应聘厨房兼职", "jp_maid_cafe_Opt_Quit": "辞去咖啡厅工作",
        "otaku_apply_greeting": "「可以申请这里的兼职，班次和时薪会列在职务说明里。」", "otaku_apply_question": "「是哪一位要应聘？」", "otaku_apply_done": "「登记好了，之后请按班次来上班。」\n（在所属家庭的管理界面，职务页的外部工作中调整班次。）", "otaku_quit_question": "「是哪一位要办理辞职？」", "otaku_quit_done": "「已办理离职，辛苦了。」", "otaku_staff_cancel": "算了", "otaku_staff_cancelLine": "「需要时再来找我。」"
    } } }
}

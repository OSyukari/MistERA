{
    "_doc": "Hospital_AutoDischarge: attached (via AddStatus onRemoveEventID) to a hospital patient's recovery status by PregnancyEnd_Birth / PregnancyEnd_CSection. Fires on the patient when the status is removed and discharges them from their temporary home (the hospital). Generic: works for any hospital whose patient MemberType carries the memberType_hospital_patient tag (MemberType.Tags). Hospital_Discharged: fired by the patient MemberType's leaveHandler (LeaveHandler_HospitalPatient.OnMemberLeft) after ANY discharge (this event, the front desk, ...), self = the patient; its text ($dischargeText$: who was discharged + every visitor who left with them) is built in code.",
    "Events": {
        "list": [
            {
                "ID": "Hospital_AutoDischarge",
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "options": [
                            {
                                "option": "_still_needs_care",
                                "_comment": "Re-checked at discharge time (this status is already gone): a patient the patient MemberType's joinHandler would still admit - e.g. another baby still in labor or waiting for a C-section, or another recovery status - stays.",
                                "self_chara_conditions": [
                                    { "parameters": [ "hasActorTag", "memberType_hospital_patient" ] },
                                    { "parameters": [ "shouldRemainMember", "@tempHome" ] }
                                ],
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "not_patient" ] } ]
                            },
                            {
                                "option": "_still_patient",
                                "self_chara_conditions": [ { "parameters": [ "hasActorTag", "memberType_hospital_patient" ] } ],
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "discharge" ] } ]
                            },
                            {
                                "option": "_not_patient",
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "not_patient" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "discharge",
                        "_comment": "the discharge itself is announced by Hospital_Discharged",
                        "line": "Hospital_AutoDischarge_recovered",
                        "Results": [
                            { "Type": "RemoveFromFaction", "arguments": [ "self", "@tempHome" ] }
                        ],
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "not_patient",
                        "line": "",
                        "isLast": true
                    }
                ]
            },
            {
                "ID": "Hospital_Discharged",
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "line": "$dischargeText$",
                        "isLast": true
                    }
                ]
            }
        ]
    },
    "Dictionary": {
        "Entries": {
            "zh-cn": {
                "Hospital_AutoDischarge_recovered": "$self.name$已经康复了。",
                "jp_hospital_discharged": "$name$从$faction$出院了。"
            },
            "en-us": {
                "Hospital_AutoDischarge_recovered": "$self.name$ has recovered.",
                "jp_hospital_discharged": "$name$ has been discharged from $faction$."
            }
        }
    }
}

{
    "_doc": "Dialogue options offered by ON-SHIFT hospital doctors/nurses (target must be active at jp_hospital AND carry the jp_hospital_staff actor tag, which only comes from the staff MemberTypes' Tags while that MemberType is their active one). Admit: done by the patient MemberType's joinHandler callback. Discharge / End visit: done by the patient / visitor MemberType's leaveHandler callbacks, for the player's own people.",
    "Events": {
        "list": [
            {
                "ID": "jp_hospital_Opt_Admit",
                "_comment": "The greeting's JoinActiveFaction asks the patient MemberType's joinHandler for the admission options (one per player/follower, disabled with a reason when they can't be admitted; none when every room is taken). Options found -> question (picking one admits them via its callback, then jumps to admit_done); none -> the handler's reason from $admitError$.",
                "allowDuplicate": false,
                "trigger": "OnDialogue_Options",
                "UISpec": { "displayMode": "AVG" },
                "SelfValidator": {
                    "chara_conditions": [
                        { "parameters": [ "exists" ] },
                        { "parameters": [ "isPlayer" ] }
                    ]
                },
                "TargetValidators": [
                    {
                        "refkeys": [ "staff" ],
                        "baseScope": "CurrentTarget",
                        "chara_conditions": [
                            { "parameters": [ "exists" ] },
                            { "parameters": [ "excludePlayer" ] },
                            { "parameters": [ "isConscious" ] },
                            { "parameters": [ "isActiveFaction", "jp_hospital" ] },
                            { "parameters": [ "hasActorTag", "jp_hospital_staff" ] }
                        ],
                        "minTargetCount": 1
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "jp_hospital_Opt_Admit_greeting",
                        "Results": [
                            { "Type": "JoinActiveFaction", "arguments": [ "admitOptions", "selfAndFollowers", "staff", "membertype_jp_hospital_patient", "admitError" ] }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "options": [
                            {
                                "option": "_has_options",
                                "Results": [
                                    { "Type": "ExistStoredOptions", "arguments": [ "admitOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "admit_ask" ] }
                                ]
                            },
                            {
                                "option": "_no_options",
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "admit_error" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "admit_error",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "$admitError$",
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "admit_ask",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "question": "jp_hospital_Opt_Admit_question",
                        "loadOptionsKey": "admitOptions",
                        "loadOptionsResults": [ { "Type": "JumpToLabel", "arguments": [ "", "admit_done" ] } ],
                        "options": [
                            {
                                "option": "jp_hospital_Opt_Admit_cancel",
                                "isDefaultCancel": true,
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "admit_cancel" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "admit_done",
                        "_comment": "Reached by picking a loaded admission option (the question's loadOptionsResults jump here).",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "jp_hospital_Opt_Admit_done"
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "_comment": "What the picked option's join callback changed (AppendFactionChange: who is now what, who stopped following).",
                        "line": "$factionChangeString$",
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "admit_cancel",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "jp_hospital_Opt_Visit_cancelLine",
                        "isLast": true
                    }
                ]
            },
            {
                "ID": "jp_hospital_Opt_Visit",
                "_comment": "JoinActiveFaction asks the visitor MemberType's joinHandler for the visit options (one per current patient; picking one makes the player + followers visitors (joining if not part of the hospital; existing visitors keep their other patients) linked to that patient). None -> the handler's reason from $visitError$ (already part of the hospital / no patients).",
                "allowDuplicate": false,
                "trigger": "OnDialogue_Options",
                "UISpec": { "displayMode": "AVG", "infoDisplay": "Hide" },
                "SelfValidator": {
                    "chara_conditions": [
                        { "parameters": [ "exists" ] },
                        { "parameters": [ "isPlayer" ] }
                    ]
                },
                "TargetValidators": [
                    {
                        "refkeys": [ "staff" ],
                        "baseScope": "CurrentTarget",
                        "chara_conditions": [
                            { "parameters": [ "exists" ] },
                            { "parameters": [ "excludePlayer" ] },
                            { "parameters": [ "isConscious" ] },
                            { "parameters": [ "isActiveFaction", "jp_hospital" ] },
                            { "parameters": [ "hasActorTag", "jp_hospital_staff" ] }
                        ],
                        "minTargetCount": 1
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "options": [
                            {
                                "option": "_has_options",
                                "Results": [
                                    { "Type": "JoinActiveFaction", "arguments": [ "visitOptions", "selfAndFollowers", "staff", "membertype_jp_hospital_visitor", "visitError" ] },
                                    { "Type": "ExistStoredOptions", "arguments": [ "visitOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "visit_ask" ] }
                                ]
                            },
                            {
                                "option": "_no_options",
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "visit_error" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "visit_error",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "$visitError$",
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "visit_ask",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "question": "jp_hospital_Opt_Visit_question",
                        "loadOptionsKey": "visitOptions",
                        "loadOptionsResults": [ { "Type": "JumpToLabel", "arguments": [ "", "visit_confirm" ] } ],
                        "options": [
                            {
                                "option": "jp_hospital_Opt_Visit_cancel",
                                "isDefaultCancel": true,
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "visit_cancel" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "visit_confirm",
                        "_comment": "Reached by picking a loaded visit option (the question's loadOptionsResults jump here).",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "jp_hospital_Opt_Visit_placeholder"
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "_comment": "What the picked option's join callback changed (AppendFactionChange: who is now what, who stopped following).",
                        "line": "$factionChangeString$",
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "visit_cancel",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "jp_hospital_Opt_Visit_cancelLine",
                        "isLast": true
                    }
                ]
            },
            {
                "ID": "jp_hospital_Opt_Discharge",
                "_comment": "Shown when a hospital patient shares the player's permanent home faction (the player or one of the player's own people). LeaveActiveFaction asks the patient MemberType's leaveHandler for one discharge option per such patient; picking one discharges them.",
                "allowDuplicate": false,
                "trigger": "OnDialogue_Options",
                "UISpec": { "displayMode": "AVG", "infoDisplay": "Hide" },
                "SelfValidator": {
                    "chara_conditions": [
                        { "parameters": [ "exists" ] },
                        { "parameters": [ "isPlayer" ] }
                    ]
                },
                "TargetValidators": [
                    {
                        "refkeys": [ "staff" ],
                        "baseScope": "CurrentTarget",
                        "chara_conditions": [
                            { "parameters": [ "exists" ] },
                            { "parameters": [ "excludePlayer" ] },
                            { "parameters": [ "isConscious" ] },
                            { "parameters": [ "isActiveFaction", "jp_hospital" ] },
                            { "parameters": [ "hasActorTag", "jp_hospital_staff" ] }
                        ],
                        "minTargetCount": 1
                    },
                    {
                        "refkeys": [ "leavers" ],
                        "baseScope": "FactionMembersWithMemberType",
                        "extraScopeArguments": [ "jp_hospital", "membertype_jp_hospital_patient" ],
                        "chara_conditions": [
                            { "parameters": [ "exists" ] },
                            { "parameters": [ "sharesHomeFaction" ] }
                        ],
                        "minTargetCount": 1
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "options": [
                            {
                                "option": "_build_options",
                                "Results": [
                                    { "Type": "LeaveActiveFaction", "arguments": [ "dischargeOptions", "leavers", "staff", "membertype_jp_hospital_patient" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "discharge_ask" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "discharge_ask",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "question": "jp_hospital_Opt_Discharge_question",
                        "loadOptionsKey": "dischargeOptions",
                        "loadOptionsResults": [ { "Type": "JumpToLabel", "arguments": [ "", "discharge_done" ] } ],
                        "options": [
                            {
                                "option": "jp_hospital_Opt_Visit_cancel",
                                "isDefaultCancel": true,
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "discharge_cancel" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "discharge_done",
                        "_comment": "Reached by picking a loaded option (the question's loadOptionsResults jump here). Who left (patient + visitors) is announced right after by Hospital_Discharged (fired by the patient MemberType's leaveHandler).",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "jp_hospital_Opt_Discharge_done",
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "discharge_cancel",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "jp_hospital_Opt_Visit_cancelLine",
                        "isLast": true
                    }
                ]
            },
            {
                "ID": "jp_hospital_Opt_EndVisit",
                "_comment": "Shown when a hospital visitor shares the player's permanent home faction (the player or one of the player's own people). LeaveActiveFaction asks the visitor MemberType's leaveHandler for one end-visit option per such visitor; picking one ends their visit.",
                "allowDuplicate": false,
                "trigger": "OnDialogue_Options",
                "UISpec": { "displayMode": "AVG" },
                "SelfValidator": {
                    "chara_conditions": [
                        { "parameters": [ "exists" ] },
                        { "parameters": [ "isPlayer" ] }
                    ]
                },
                "TargetValidators": [
                    {
                        "refkeys": [ "staff" ],
                        "baseScope": "CurrentTarget",
                        "chara_conditions": [
                            { "parameters": [ "exists" ] },
                            { "parameters": [ "excludePlayer" ] },
                            { "parameters": [ "isConscious" ] },
                            { "parameters": [ "isActiveFaction", "jp_hospital" ] },
                            { "parameters": [ "hasActorTag", "jp_hospital_staff" ] }
                        ],
                        "minTargetCount": 1
                    },
                    {
                        "refkeys": [ "leavers" ],
                        "baseScope": "FactionMembersWithMemberType",
                        "extraScopeArguments": [ "jp_hospital", "membertype_jp_hospital_visitor" ],
                        "chara_conditions": [
                            { "parameters": [ "exists" ] },
                            { "parameters": [ "sharesHomeFaction" ] }
                        ],
                        "minTargetCount": 1
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "options": [
                            {
                                "option": "_build_options",
                                "Results": [
                                    { "Type": "LeaveActiveFaction", "arguments": [ "endVisitOptions", "leavers", "staff", "membertype_jp_hospital_visitor" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "endvisit_ask" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "endvisit_ask",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "question": "jp_hospital_Opt_EndVisit_question",
                        "loadOptionsKey": "endVisitOptions",
                        "loadOptionsResults": [ { "Type": "JumpToLabel", "arguments": [ "", "endvisit_done" ] } ],
                        "options": [
                            {
                                "option": "jp_hospital_Opt_Visit_cancel",
                                "isDefaultCancel": true,
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "endvisit_cancel" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "endvisit_done",
                        "_comment": "Reached by picking a loaded option (the question's loadOptionsResults jump here).",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "jp_hospital_Opt_EndVisit_done"
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "_comment": "What the picked option's leave callback changed (AppendFactionLeave: who is no longer what).",
                        "line": "$factionChangeString$",
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "endvisit_cancel",
                        "UISpec": { "portraitRefKey": "staff", "selfTags": [ "focused" ] },
                        "line": "jp_hospital_Opt_Visit_cancelLine",
                        "isLast": true
                    }
                ]
            }
        ]
    },
    "Dictionary": {
        "Entries": {
            "zh-cn": {

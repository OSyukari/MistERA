        "_comment_holidayDefs": "One date resolves to at most ONE holiday (first entry wins on overlap) - multi-day festivals whose phases differ are split into separate entries sharing a theme tag. national_holiday = 放假, observance = 不放假. Rules: fixed (month/day), equinox (spring/autumn, computed), silverWeek (occurs only in years where respect-for-aged monday + bridge day + autumn equinox form one Mon-Wed run).",
        "holidayDefs":
        [
            { "ID":"holiday_jp_ganjitsu",        "tags":["newyear", "national_holiday"],     "rule":{ "type":"fixed", "month":1,  "day":1 } },
            { "ID":"holiday_jp_shogatsu_d2",     "tags":["newyear", "national_holiday"],     "rule":{ "type":"fixed", "month":1,  "day":2 } },
            { "ID":"holiday_jp_shogatsu_d3",     "tags":["newyear", "national_holiday"],     "rule":{ "type":"fixed", "month":1,  "day":3 } },
            { "ID":"holiday_jp_valentine",       "tags":["valentine", "observance"],         "rule":{ "type":"fixed", "month":2,  "day":14 } },
            { "ID":"holiday_jp_white_day",       "tags":["whiteday", "observance"],          "rule":{ "type":"fixed", "month":3,  "day":14 } },
            { "ID":"holiday_jp_spring_equinox",  "tags":["national_holiday"],                "rule":{ "type":"equinox", "equinox":"spring" } },
            { "ID":"holiday_jp_gw_start",        "tags":["goldenweek", "national_holiday"],  "rule":{ "type":"fixed", "month":4,  "day":29 } },
            { "ID":"holiday_jp_gw_mid1",         "tags":["goldenweek", "national_holiday"],  "rule":{ "type":"fixed", "month":5,  "day":3 } },
            { "ID":"holiday_jp_gw_mid2",         "tags":["goldenweek", "national_holiday"],  "rule":{ "type":"fixed", "month":5,  "day":4 } },
            { "ID":"holiday_jp_gw_end",          "tags":["goldenweek", "national_holiday"],  "rule":{ "type":"fixed", "month":5,  "day":5 } },
            { "ID":"holiday_jp_tanabata",        "tags":["tanabata", "observance"],          "rule":{ "type":"fixed", "month":7,  "day":7 } },
            { "ID":"holiday_jp_obon_mukaebi",    "tags":["obon", "national_holiday"],        "rule":{ "type":"fixed", "month":8,  "day":13 } },
            { "ID":"holiday_jp_obon_okuribi",    "tags":["obon", "national_holiday"],        "rule":{ "type":"fixed", "month":8,  "day":14 }, "durationDays":2 },
            { "ID":"holiday_jp_silverweek",      "tags":["silverweek", "national_holiday"],  "rule":{ "type":"silverWeek" }, "durationDays":3 },
            { "ID":"holiday_jp_christmas_eve",   "tags":["christmas", "observance"],         "rule":{ "type":"fixed", "month":12, "day":24 } },
            { "ID":"holiday_jp_christmas",       "tags":["christmas", "observance"],         "rule":{ "type":"fixed", "month":12, "day":25 } },
            { "ID":"holiday_jp_omisoka",         "tags":["newyear_eve", "observance"],       "rule":{ "type":"fixed", "month":12, "day":31 } }
        ],
        "_comment_seasonDefs": "Seasons are independent from holidays: a date resolves to at most one holiday but any number of seasons. Ranges may wrap around the year end (start month/day > end month/day).",
        "seasonDefs":
        [
            { "ID":"season_spring", "tags":["spring"],          "ranges":[{ "startMonth":3,  "startDay":1,  "endMonth":5,  "endDay":31 }] },
            { "ID":"season_summer", "tags":["summer"],          "ranges":[{ "startMonth":6,  "startDay":1,  "endMonth":8,  "endDay":31 }] },
            { "ID":"season_autumn", "tags":["autumn"],          "ranges":[{ "startMonth":9,  "startDay":1,  "endMonth":11, "endDay":30 }] },
            { "ID":"season_winter", "tags":["winter"],          "ranges":[{ "startMonth":12, "startDay":1,  "endMonth":2,  "endDay":28 }] },
            { "ID":"season_hanabi", "tags":["hanabi", "summer_festival"], "ranges":[{ "startMonth":7, "startDay":1, "endMonth":8, "endDay":31 }] }
        ]
    }
],
    "clienteleDefs": [
        {
            "_comment": "AV buyers - every evaluated recording (item_records + its evaluator tag, see ItemComponent_Records.GetTags). Segments split the audience by genre taste; a tape only sells to segments with affinity for its evaluator.",
            "ID": "salesclientele_av",
            "itemReq": { "requireTags": [ "item_records" ] },
            "tags": [ "AV", "nsfw" ],
            "_comment_limitedAudience": "each buyer buys a title once: potential buyers per segment = population x ratio x market share x segment weight x affinity x quality; 200000 x 0.15 x 1% = 300 buyers across all segments",
            "limitedAudience": true,
            "dailyPurchaseRate": 0.03,
            "ratio": 0.15,
            "fluctuation": 0.15,
            "popularityInfluence": 5.0,
            "usePopularityCurve": true,
            "curvePeakDay": 5,
            "curveDecayPerDay": 0.1,
            "curveFloorRatio": 0.3,
            "segments": [
                {
                    "ID": "seg_proper_av",
                    "weight": 0.6,
                    "affinity": { "receval_proper_av": 1.0, "receval_homemade_tape": 0.2, "receval_voyeur": 0.2 }
                },
                {
                    "ID": "seg_amateur",
                    "weight": 0.15,
                    "affinity": { "receval_homemade_tape": 1.0, "receval_voyeur": 0.5, "receval_proper_av": 0.2 }
                },
                {
                    "ID": "seg_voyeur",
                    "weight": 0.25,
                    "affinity": { "receval_voyeur": 1.0, "receval_homemade_tape": 0.5 }
                }
            ]
        }
    ],

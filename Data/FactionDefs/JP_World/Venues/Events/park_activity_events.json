      ]
    },
    {
      "ID": "Venue_Playground_Begin", "events": [
        { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "options": [
          { "option": "explicit join", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["isJoin"] }, { "Type": "JumpToLabel", "arguments": ["", "join"] }] },
          { "option": "late arrival", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["isLate"] }, { "Type": "JumpToLabel", "arguments": ["", "late"] }] },
          { "option": "initial launch", "Results": [{ "Type": "JumpToLabel", "arguments": ["", "initial"] }] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "initial", "line": "Venue_Playground_initial", "isLast": true, "Results": [{ "Type": "FlushMessageExpAll", "arguments": ["false"] }] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "join", "line": "Venue_Playground_join", "isLast": true },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "late", "line": "Venue_Playground_late", "isLast": true }

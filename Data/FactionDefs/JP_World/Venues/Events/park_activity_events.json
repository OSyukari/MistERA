{
  "_comment": "Mounted proposal scenes. isJoin before isLate; presence guards contain comparisons and jumps only. Rewards live on separate nodes and target real attendees, never expected guests. A one-minute arrival is not a completed two-hour visit. No acceptance/end-of-visit reward or time/check executors. Trust is not granted here: the job pays it at the launch to those who agreed beforehand and came on time (Job_Activity.AwardKeptPromiseTrust) - these scenes add Goodwill only.",
  "Events": { "list": [
    {
      "ID": "Venue_ParkStroll_Begin",
      "events": [
        { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "options": [
          { "option": "explicit join", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["isJoin"] }, { "Type": "JumpToLabel", "arguments": ["", "join"] }] },
          { "option": "late arrival", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["isLate"] }, { "Type": "JumpToLabel", "arguments": ["", "late"] }] },
          { "option": "initial launch", "Results": [{ "Type": "JumpToLabel", "arguments": ["", "initial"] }] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "initial", "line": "Venue_Stroll_initial", "nextEntryLabel": "initial_guard" },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "join", "line": "Venue_Stroll_join", "nextEntryLabel": "arrival_guard" },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "late", "line": "Venue_Stroll_late", "nextEntryLabel": "arrival_guard" },
        { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "label": "initial_guard", "options": [
          { "option": "eligible shared moment", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["activityTrustEligible"] }, { "Type": "ExistAppendStrings", "arguments": ["hasSharedAttendees"] }, { "Type": "JumpToLabel", "arguments": ["", "initial_reward"] }] },
          { "option": "neutral continuation", "Results": [{ "Type": "JumpToLabel", "arguments": ["", "finish"] }] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "label": "arrival_guard", "options": [
          { "option": "eligible shared moment", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["activityTrustEligible"] }, { "Type": "ExistAppendStrings", "arguments": ["hasCompanions"] }, { "Type": "JumpToLabel", "arguments": ["", "arrival_reward"] }] },
          { "option": "neutral continuation", "Results": [{ "Type": "JumpToLabel", "arguments": ["", "finish"] }] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "initial_reward", "line": "Venue_Stroll_shared_initial", "nextEntryLabel": "finish", "Results": [
          { "Type": "IncreaseRelationship", "arguments": ["attendees", "attendees", "Goodwill", "1"] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "arrival_reward", "line": "Venue_Stroll_shared_arrival", "nextEntryLabel": "finish", "Results": [
          { "Type": "IncreaseRelationship", "arguments": ["joining", "companions", "Goodwill", "1"] }, { "Type": "IncreaseRelationship", "arguments": ["companions", "joining", "Goodwill", "1"] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "finish", "line": "Venue_Stroll_finish", "isLast": true, "Results": [{ "Type": "FlushMessageExpAll", "arguments": ["false"] }] }
      ]
    },
    {
      "ID": "Venue_CommunityCleanup_Begin",
      "_comment": "Only the small shared bagging task is narrated as finished; the full cleanup area and booked duration are not completed by entry.",
      "events": [
        { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "options": [
          { "option": "explicit join", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["isJoin"] }, { "Type": "JumpToLabel", "arguments": ["", "join"] }] },
          { "option": "late arrival", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["isLate"] }, { "Type": "JumpToLabel", "arguments": ["", "late"] }] },
          { "option": "initial launch", "Results": [{ "Type": "JumpToLabel", "arguments": ["", "initial"] }] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "initial", "line": "Venue_Cleanup_initial", "nextEntryLabel": "initial_guard" },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "join", "line": "Venue_Cleanup_join", "nextEntryLabel": "arrival_guard" },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "late", "line": "Venue_Cleanup_late", "nextEntryLabel": "arrival_guard" },
        { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "label": "initial_guard", "options": [
          { "option": "eligible small shared task", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["activityTrustEligible"] }, { "Type": "ExistAppendStrings", "arguments": ["hasSharedAttendees"] }, { "Type": "JumpToLabel", "arguments": ["", "initial_reward"] }] },
          { "option": "neutral continuation", "Results": [{ "Type": "JumpToLabel", "arguments": ["", "finish"] }] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "label": "arrival_guard", "options": [
          { "option": "eligible small shared task", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["activityTrustEligible"] }, { "Type": "ExistAppendStrings", "arguments": ["hasCompanions"] }, { "Type": "JumpToLabel", "arguments": ["", "arrival_reward"] }] },
          { "option": "neutral continuation", "Results": [{ "Type": "JumpToLabel", "arguments": ["", "finish"] }] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "initial_reward", "line": "Venue_Cleanup_shared_initial", "nextEntryLabel": "finish", "Results": [
          { "Type": "IncreaseRelationship", "arguments": ["attendees", "attendees", "Goodwill", "1"] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "arrival_reward", "line": "Venue_Cleanup_shared_arrival", "nextEntryLabel": "finish", "Results": [
          { "Type": "IncreaseRelationship", "arguments": ["joining", "companions", "Goodwill", "1"] }, { "Type": "IncreaseRelationship", "arguments": ["companions", "joining", "Goodwill", "1"] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "finish", "line": "Venue_Cleanup_finish", "isLast": true, "Results": [{ "Type": "FlushMessageExpAll", "arguments": ["false"] }] }
      ]
    },
    {
      "ID": "Venue_Picnic_Begin", "events": [
        { "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp", "options": [
          { "option": "explicit join", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["isJoin"] }, { "Type": "JumpToLabel", "arguments": ["", "join"] }] },
          { "option": "late arrival", "Results": [{ "Type": "ExistAppendStrings", "arguments": ["isLate"] }, { "Type": "JumpToLabel", "arguments": ["", "late"] }] },
          { "option": "initial launch", "Results": [{ "Type": "JumpToLabel", "arguments": ["", "initial"] }] }
        ] },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "initial", "line": "Venue_Picnic_initial", "isLast": true },
        { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "join", "line": "Venue_Picnic_join", "isLast": true },

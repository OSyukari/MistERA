{
    "Events": {
        "list": [
            {
                "_comment": "Kanon_IntroduceActress. OnDialogue_Options. Only visible once erav_kanon_offer==2. Big roster questionbox (currently one entry: Kanade) plus an exit choice, per plan §9/§0 (erav_introduced_<actressID> registry). Picking a candidate writes erav_introduced_ErAV_Kanade=1 regardless of the accept/refuse outcome, then shows Kanon's pitch + a short self-intro from the candidate's own POV, then an accept/refuse questionbox: accept ends the event, refuse loops back to the roster (ia_select). Each actress gets her own TargetValidators entry with allowEventOnMinTargetCountMiss=true (so a missing candidate doesn't block the whole event/roster, only leaves her refkey unbound) plus a matching target_chara_conditions requirement on her roster option, per EventUtility.isValid(Options,...) (EventUtility.cs:567-584) checked by scr_menu_question.cs's Button_OptionBtn.IsButtonValid -- every option always renders a button, this just disables it when the refkey didn't resolve. Kanade is pulled in via BaseID_Unrestricted (same technique as Opening_ErAV.json / quest.json's prerequisites). No currency is deducted for the handling fee -- there's no ExecutionType for it yet -- so the fee is framed as coming out of future earnings instead of an upfront charge.",
                "ID": "Kanon_IntroduceActress",
                "allowDuplicate": false,
                "trigger": "OnDialogue_Options",
                "UISpec": {
                    "displayMode":"AVG",
                    "infoDisplay":"Hide"
                },
                "SelfValidator": {
                    "chara_conditions": [
                        { "parameters": [ "exists" ] },
                        { "parameters": [ "isActorBaseID", "ErAV_Player" ] },
                        {
                            "requireKojoVariable": {
                                "variableID": "erav_kanon_offer",
                                "operand": "eq",
                                "value": 2
                            }
                        }
                    ]
                },
                "TargetValidators": [
                    {
                        "refkeys": [ "kanon" ],
                        "baseScope": "CurrentTarget",
                        "chara_conditions": [
                            { "parameters": [ "isActorBaseID", "ErAV_Kanon" ] },
                            { "parameters": [ "isActiveFaction", "ErAV_KiryuGumi_Office" ] }
                        ],
                        "minTargetCount": 1
                    },
                    {
                        "refkeys": [ "kanade" ],
                        "baseScope": "BaseID_Unrestricted",
                        "extraScopeArguments": [ "ErAV_Kanade" ],
                        "minTargetCount": 1,
                        "allowEventOnMinTargetCountMiss": true
                    },
                    {
                        "refkeys": [ "Jitaku_Sayaka" ],
                        "baseScope": "BaseID_Unrestricted",
                        "extraScopeArguments": [ "Jitaku_Sayaka" ],
                        "minTargetCount": 1,
                        "allowEventOnMinTargetCountMiss": true
                    },
                    {
                        "refkeys": [ "Jitaku_Shouko" ],
                        "baseScope": "BaseID_Unrestricted",
                        "extraScopeArguments": [ "Jitaku_Shouko" ],
                        "minTargetCount": 1,
                        "allowEventOnMinTargetCountMiss": true
                    },
                    {
                        "refkeys": [ "Jitaku_Yuki" ],
                        "baseScope": "BaseID_Unrestricted",
                        "extraScopeArguments": [ "Jitaku_Yuki" ],
                        "minTargetCount": 1,
                        "allowEventOnMinTargetCountMiss": true
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "ia_select",
                        "UISpec": {
                            "portraitRefKey": "kanon",
                            "selfTags": [ "yakuza", "confident", "relaxed" ]
                        },
                        "question": "kia_L01",
                        "options": [
                            {
                                "option": "Kanon_IntroduceActress_Kanade",
                                "target_chara_conditions": {
                                    "kanade": [
                                        { "parameters": [ "exists" ] },
                                        {
                                            "relationshipTargetKey":"self",
                                            "requireKojoVariable": {
                                                "variableID": "erav_actress_status",
                                                "operand": "eq",
                                                "value": 1
                                            }
                                        }
                                    ]
                                },
                                "Results": [
                                    {
                                        "Type": "JumpToLabel",
                                        "arguments": [ "", "ia_kanade_intro" ]
                                    }
                                ]
                            },
                            {
                                "option": "Kanon_IntroduceActress_Jitaku_Sayaka",
                                "target_chara_conditions": {
                                    "Jitaku_Sayaka": [
                                        { "parameters": [ "exists" ] },
                                        {
                                            "relationshipTargetKey":"self",
                                            "requireKojoVariable": {
                                                "variableID": "erav_actress_status",
                                                "operand": "eq",
                                                "value": 1
                                            }
                                        }
                                    ]
                                },
                                "Results": [
                                    {
                                        "Type": "JumpToLabel",
                                        "arguments": [ "", "ia_jitaku_sayaka_intro" ]
                                    }
                                ]
                            },
                            {
                                "option": "kia_Q01_op2",
                                "isDefaultCancel": true,
                                "Results": [
                                    {
                                        "Type": "JumpToLabel",
                                        "arguments": [ "", "ia_end" ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "ia_kanade_intro",
                        "UISpec": {
                            "portraitRefKey": "kanade"
                        },
                        "line": "Kanon_IntroduceActress_Kanade_Intro"
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "UISpec": {
                            "portraitRefKey": "kanade"
                        },
                        "line": "Kanon_IntroduceActress_Kanade_Monologue"
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "UISpec": {
                            "portraitRefKey": "kanon",
                            "selfTags": [ "yakuza", "focused", "serious" ]
                        },
                        "line": "Kanon_IntroduceActress_Kanade_Comment"
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "UISpec": {
                            "portraitRefKey": "kanade"
                        },
                        "question": "Kanon_IntroduceActress_Kanade_Choice",
                        "options": [
                            {
                                "option": "Kanon_IntroduceActress_Select",
                                "Results": [
                                    {
                                        "Type": "JumpToLabel",
                                        "arguments": [ "", "ia_kanade_accept" ]
                                    }
                                ]
                            },
                            {
                                "option": "Kanon_IntroduceActress_CancelSelect",
                                "isDefaultCancel": true,
                                "Results": [
                                    {
                                        "Type": "JumpToLabel",
                                        "arguments": [ "", "ia_refuse" ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "ia_kanade_accept",
                        "UISpec": {
                            "portraitRefKey": "kanon",
                            "selfTags": [ "yakuza", "confident", "relaxed" ]
                        },
                        "line": "Kanon_IntroduceActress_Kanade_Select",
                        "Results": [
                            {
                                "Type": "SetRelKojoVariable",
                                "arguments": [ "kanade", "self", "false", "erav_actress_status", "1" ]
                            }
                        ],
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "ia_jitaku_sayaka_intro",
                        "UISpec": {
                            "portraitRefKey": ""
                        },
                        "line": "Kanon_IntroduceActress_JitakuSayaka_Intro"

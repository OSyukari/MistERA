                        "label": "ia_jitaku_sayaka_accept",
                        "UISpec": {
                            "portraitRefKey": "kanon",
                            "selfTags": [ "yakuza", "confident", "relaxed" ]
                        },
                        "line": "Kanon_IntroduceActress_JitakuSayaka_Select",
                        "Results": [
                            {
                                "Type": "SetRelKojoVariable",
                                "arguments": [ "Jitaku_Sayaka", "self","false", "erav_actress_status", "1" ]
                            }

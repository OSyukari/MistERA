{
    "Events": {
        "list": [
            {
                "ID": "Kanon_Dialogue",
                "allowDuplicate": false,
                "trigger": "OnDialogue",
                "SelfValidator": {
                    "chara_conditions": [
                        {
                            "parameters": [
                                "exists"
                            ]
                        },
                        {
                            "parameters": [
                                "isActorBaseID",
                                "ErAV_Player"
                            ]
                        }
                    ]
                },
                "UISpec": {
                    "displayMode":"AVG",
                    "infoDisplay":"Hide"
                },
                "TargetValidators": [
                    {
                        "refkeys": [
                            "kanon"
                        ],
                        "baseScope": "CurrentTarget",
                        "chara_conditions": [
                            {
                                "parameters": [
                                    "isActorBaseID",
                                    "ErAV_Kanon"
                                ]
                            }
                        ],
                        "minTargetCount": 1
                    },
                    {
                        "refkeys": [
                            "kanade"
                        ],
                        "baseScope": "AllCharaInSelfRoom",
                        "chara_conditions": [
                            {
                                "parameters": [
                                    "isActorBaseID",
                                    "ErAV_Kanade"
                                ]
                            }
                        ],
                        "minTargetCount": 1,
                        "allowEventOnMinTargetCountMiss": true
                    },
                    {
                        "refkeys": [
                            "victim"
                        ],
                        "minTargetCount": 1,
                        "allowEventOnMinTargetCountMiss": true
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "_comment": "Top-level split: kanon in her office vs. anywhere else.",

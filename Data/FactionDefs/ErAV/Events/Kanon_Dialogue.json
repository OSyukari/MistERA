                            {
                                "option": "debt_month_reached",
                                "self_chara_conditions": [
                                    {
                                        "requireKojoVariable": {
                                            "variableID": "erav_debt_month",
                                            "operand": "gte",
                                            "value": 1
                                        }
                                    }
                                ],
                                "Results": [
                                    { "Type": "JumpToLabel", "arguments": [ "", "debt_status_victim_check" ] }
                                ]
                            },
                            {
                                "option": "_fallback_no_debt_commentary",
                                "Results": [
                                    { "Type": "JumpToLabel", "arguments": [ "", "job_offer_check" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",

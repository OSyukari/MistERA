                        "line": "Kanon_Dialogue_inoffice",
                        "nextEntryLabel": "debt_status_check"
                    },

                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "debt_status_check",

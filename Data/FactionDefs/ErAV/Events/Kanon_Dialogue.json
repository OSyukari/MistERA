                                    "kanon":[
                                        { "parameters": [ "isActiveFaction", "ErAV_KiryuGumi_Office" ] }
                                    ]
                                },
                                "Results": [
                                    { "Type": "JumpToLabel", "arguments": [ "", "Kanon_Dialogue_inoffice_begin" ] }
                                ]
                            },
                            {
                                "option": "_not_in_office_firstvisit",
                                "self_chara_conditions": [
                                    {
                                        "requireKojoVariable": {
                                            "variableID": "erav_kanon_offer",
                                            "operand": "eq",
                                            "value": 1
                                        }
                                    }
                                ],
                                "Results": [
                                    {
                                        "Type": "JumpToLabel",
                                        "arguments": [
                                            "",
                                            "Kanon_Dialogue_NotInOffice"
                                        ]
                                    }
                                ]
                            },
                            {
                                "option": "_fallback_not_in_office_else",
                                "Results": [
                                    {
                                        "Type": "GetKojoEntry",
                                        "arguments": [
                                            "kanon",
                                            "self",
                                            "DailyGreeting",
                                            "greeting"
                                        ]
                                    },
                                    {
                                        "Type": "JumpToLabel",
                                        "arguments": [
                                            "",
                                            "br_greeting"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {

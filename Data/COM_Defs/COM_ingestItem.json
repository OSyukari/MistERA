{
    "_doc": "Item use commands (Docs/Interactions/Plan_UseItemFolders.md). com_useItem is the template of the per-item 使用 folders (COM_ItemFolder, built for every item a command names in itemFolder); it is never shown itself. The ingest generators below are hidden templates: each makes one command per consumable with this route, listed under that item's folder. One fixed targeting per command: _self = the doer takes it (selfOnly, any target is ignored), _onTarget = the doer gives it to the receiver.",
    "COMs": {
        "list": [
            {
                "$type": "COM_ItemFolder, Assembly-CSharp",
                "ID": "com_useItem",
                "ActionPackageClass": "ActionPackage_Interaction",
                "displayName": "com_useItem_displayName",
                "hidden": true,
                "comTags": ["interaction", "ingestItem", "allowedDuringSex"],
                "requirements": {
                    "requirement": {
                        "req_Receivers": { "requireConscious": false, "requireAction": false }
                    }
                }
            },
            {
                "ID": "com_furniture_ingestStomach_self",
                "kojoParticipants": "SoloOnly",
                "ActionPackageClass": "ActionPackage_Interaction",
                "displayName": "com_furniture_ingestStomach_self",
                "hidden": true,
                "GenerateCOM": {
                    "itemTag": "consumable",
                    "targetCOMClass": {
                        "$type": "COM_IngestItem, Assembly-CSharp",
                        "ID": "com_furniture_ingestStomach_self",
                        "ActionPackageClass": "ActionPackage_Interaction",
                        "displayName": "com_furniture_ingestStomach_self",
                        "itemFolder": "$itemID$",
                        "selfOnly": true,
                        "ingestBodyTag": "stomach",
                        "timeScale": 5,
                        "comTags": ["interaction", "ingestItem", "allowedDuringSex"],
                        "requirements": {
                            "requirement": {
                                "req_Receivers": { "requireConscious": false, "requireAction": false }
                            }
                        },
                        "variants": [
                            {
                                "requirements": { "requirement": { "doerCount": 1, "receiverCount": 0, "treatDoerAsReceiver": true } },
                                "displayName": "com_furniture_ingestStomach_self"
                            }
                        ],
                        "AcceptanceCheck": { "baseAcceptanceValue": 40 },
                        "DifficultyCheck": { "baseD20Check": 0 },
                        "description_begin": { "Entries":[
                            { "conditions":[{"validatePackage":{"existsMaster_NonActor":true}}], "texts":["com_furniture_ingestStomach_begin_ordered_1", "com_furniture_ingestStomach_begin_ordered_2", "com_furniture_ingestStomach_begin_ordered_3"] },
                            { "texts":["com_furniture_ingestStomach_begin_1", "com_furniture_ingestStomach_begin_2", "com_furniture_ingestStomach_begin_3"] }
                        ], "keepLooking": false },
                        "description_ongoing": { "Entries":[{"texts":["com_furniture_ingestStomach_ongoing_1", "com_furniture_ingestStomach_ongoing_2", "com_furniture_ingestStomach_ongoing_3"]}], "keepLooking": false },
                        "description_onComplete": { "Entries":[{"keepLooking": true, "texts":["com_furniture_ingestStomach_onComplete_1", "com_furniture_ingestStomach_onComplete_2", "com_furniture_ingestStomach_onComplete_3"]}] },
                        "description_remove": { "Entries":[{"texts":["com_furniture_ingestStomach_remove_1", "com_furniture_ingestStomach_remove_2", "com_furniture_ingestStomach_remove_3"]}], "keepLooking": false }
                    }
                }
            },
            {
                "ID": "com_furniture_ingestStomach_onTarget",
                "kojoParticipants": "PairDistinct",
                "ActionPackageClass": "ActionPackage_Interaction",
                "displayName": "com_furniture_ingestStomach_onTarget",
                "hidden": true,
                "GenerateCOM": {
                    "itemTag": "consumable",
                    "targetCOMClass": {
                        "$type": "COM_IngestItem, Assembly-CSharp",
                        "ID": "com_furniture_ingestStomach_onTarget",
                        "kojoParticipants": "PairDistinct",
                        "ActionPackageClass": "ActionPackage_Interaction",
                        "displayName": "com_furniture_ingestStomach_onTarget",
                        "itemFolder": "$itemID$",
                        "ingestBodyTag": "stomach",
                        "timeScale": 5,
                        "comTags": ["interaction", "ingestItem", "allowedDuringSex"],
                        "requirements": {
                            "requirement": {
                                "req_Receivers": { "requireConscious": false, "requireAction": false }
                            }
                        },
                        "variants": [
                            {
                                "requirements": { "requirement": { "doerCount": 1, "receiverCount": 1 } },
                                "displayName": "com_furniture_ingestStomach_onTarget"
                            }
                        ],
                        "AcceptanceCheck": { "baseAcceptanceValue": 40 },
                        "DifficultyCheck": { "baseD20Check": 0 },
                        "description_begin": { "Entries":[
                            { "conditions":[{"validatePackage":{"existsMaster_NonActor":true}}], "texts":["com_furniture_ingestStomach_begin_administer_ordered_1", "com_furniture_ingestStomach_begin_administer_ordered_2", "com_furniture_ingestStomach_begin_administer_ordered_3"] },
                            { "texts":["com_furniture_ingestStomach_begin_administer", "com_furniture_ingestStomach_begin_administer_1", "com_furniture_ingestStomach_begin_administer_2"] }
                        ], "keepLooking": false },
                        "description_ongoing": { "Entries":[{"texts":["com_furniture_ingestStomach_ongoing_administer", "com_furniture_ingestStomach_ongoing_administer_1", "com_furniture_ingestStomach_ongoing_administer_2"]}], "keepLooking": false },
                        "description_onComplete": { "Entries":[{"keepLooking": true, "texts":["com_furniture_ingestStomach_onComplete_administer", "com_furniture_ingestStomach_onComplete_administer_1", "com_furniture_ingestStomach_onComplete_administer_2"]}] },
                        "description_remove": { "Entries":[{"texts":["com_furniture_ingestStomach_remove_administer_1", "com_furniture_ingestStomach_remove_administer_2", "com_furniture_ingestStomach_remove_administer_3"]}], "keepLooking": false }
                    }
                }
            }
        ]
    },
    "Dictionary": {
        "Entries": {
            "zh-cn": {

    "Dictionary": {
        "Entries": {
            "zh-cn": {
                "com_touch_ears_Begin_Allow_1": "$self$鼻尖溢出一声舒适的轻哼：\"嗯……那里弄得我好痒。\"",
                "com_touch_ears_Begin_Allow_2": "$self$微微偏过头，任由$target$的手指揉捏自己的耳垂：\"轻一点啊。\"",
                "com_touch_ears_Begin_Allow_3": "$self$缩着脖子笑了一下：\"别闹……好吧，就让你摸一会儿。\"",
                "com_touch_ears_Begin_Allow_4": "$self$缓缓合上眼，脸上露出放松的神情，任由$target$抚弄耳朵。",
                "com_touch_ears_Begin_NoAllow_Like_1": "$self$愣在原地，睁大眼睛看着$target$：\"诶？那个……怎么突然摸耳朵？\"",
                "com_touch_ears_Begin_NoAllow_Like_2": "$self$的肩膀猛地一缩，耳根瞬间发红：\"等、等一下……！\"",
                "com_touch_ears_Begin_NoAllow_Like_3": "$self$有些无措地眨了眨眼，声音小了些：\"……突然这样，怪让人紧张的。\"",
                "com_touch_ears_Begin_NoAllow_Hate_1": "$self$咬住下唇，身体因害怕而微微发抖，不敢发出半点反抗的声音。",
                "com_touch_ears_Begin_NoAllow_Hate_2": "$self$盯着地面，眼眶微微泛红，强忍着不适任由那只手碰触自己。",
                "com_touch_ears_Begin_NoAllow_Hate_3": "$self$垂下双手，声音发颤：\"……请、请别用力……\"",
                "com_touch_ears_Sleep_1": "$self$在睡梦中含糊嘟囔了一句，缩了缩脖子，却没有醒来。",
                "com_touch_ears_Sleep_2": "$self$呼吸依旧平稳，只是耳垂被揉捏时喉间发出轻浅的哼声。",
                "com_touch_ears_Sleep_3": "$self$沉沉睡着，被反复碰触耳朵也只微微偏了下头。",
                "com_touch_ears_TimeStop_1": "$self$保持着静止的姿态，柔软的耳垂随$target$手指的揉捏微微变形。",
                "com_touch_ears_TimeStop_2": "$self$毫无知觉地站在原地，对耳廓上传来的触碰没有任何反应。",
                "com_touch_ears_TimeStop_3": "$self$眼神凝固在上一秒的落点上，连呼吸起伏都停在原处。",
                "com_touch_ears_Fail_Allow_1": "$self$笑着缩了缩脖子，瞪了$target$一眼：\"好痒呀，别闹了！\"",
                "com_touch_ears_Fail_Allow_2": "$self$偏过头冲$target$摆摆手：\"你的手太冰了！今天不想被摸耳朵！\"",
                "com_touch_ears_Fail_Allow_3": "$self$无奈地叹了口气：\"我现在正忙着呢，没空陪你玩这个。\"",
                "com_touch_ears_Fail_NoAllow_Like_1": "$self$尴尬地笑了笑，礼貌地摇摇头：\"那个……我不太习惯这样的接触，抱歉。\"",
                "com_touch_ears_Fail_NoAllow_Like_2": "$self$神情有些局促：\"如果是开玩笑的话，稍微有点过火了哦。\"",
                "com_touch_ears_Fail_NoAllow_Like_3": "$self$用疑惑的目光看着$target$：\"我们聊的事，应该和我的耳朵没关系吧？\"",
                "com_touch_ears_Fail_NoAllow_Hate_1": "$self$沉下脸喝道：\"别碰我！\"",
                "com_touch_ears_Fail_NoAllow_Hate_2": "$self$拉下脸瞪着$target$，声音冷硬：\"你这是在干什么？请自重。\"",
                "com_touch_ears_Fail_NoAllow_Hate_3": "$self$满脸嫌恶地别过头：\"离我远点，别用你的手碰我耳朵。\"",
                "com_touch_ears_Succ_Allow_1": "$self$的呼吸变得有些急促，脸颊染上红晕：\"嗯……这样摸着，意外地很舒服……\"",
                "com_touch_ears_Succ_Allow_2": "$self$软绵绵地倚靠过来，声音轻软：\"再多摸一会儿……那边也要。\"",
                "com_touch_ears_Succ_Allow_3": "$self$半眯着眼轻笑了一声：\"你的手法还挺轻柔的嘛。\"",
                "com_touch_ears_Succ_NoAllow_1": "$self$原本紧绷的肩膀慢慢松了下来，脸颊泛红：\"奇怪……倒也不怎么讨厌……\"",
                "com_touch_ears_Succ_NoAllow_2": "$self$呼吸略微沉重，小声嘀咕：\"……就这一次，别摸太久。\"",
                "com_touch_ears_Succ_NoAllow_3": "$self$垂下视线不敢看$target$，耳根烫得厉害，却没再露出抗拒的神色。",
                "com_touch_ears_Bad_Allow_1": "$self$有些不耐烦地偏了偏头，抱怨道：\"够了吧？耳垂都被你捏痛了。\"",
                "com_touch_ears_Bad_Allow_2": "$self$语气生硬起来：\"这种感觉怪怪的……我不喜欢，停下吧。\"",
                "com_touch_ears_Bad_Allow_3": "$self$叹了口气，神色带着不满：\"玩够了吗？我的耳朵都要被你搓红了。\"",
                "com_touch_ears_Bad_NoAllow_1": "$self$忍耐到了头，冲$target$怒喝道：\"变态！离我远点！\"",
                "com_touch_ears_Bad_NoAllow_2": "$self$眼眶发红，声音发哑：\"恶心……别再碰我耳朵了……\"",
                "com_touch_ears_Bad_NoAllow_3": "$self$浑身发抖地别过脸去，看向$target$的眼神里满是反感与委屈。",
                "com_touch_ears_Begin_Sleep_1": "$target$捻住熟睡中的耳垂轻轻揉搓，$self$在梦里偏了偏头，没醒。",
                "com_touch_ears_Begin_Sleep_2": "耳廓被指腹碾着慢慢透红，$self$原本平稳的呼吸乱了一拍，随后又沉回梦里。",
                "com_touch_ears_Begin_Timestop_1": "$target$捻住定格的耳垂揉搓，$self$站在原地一动不动，连脖颈都没有缩一下。",
                "com_touch_ears_Begin_Timestop_2": "耳垂被捏着轻轻拉扯，$self$的目光停在原来的落点上，没有任何反应。",

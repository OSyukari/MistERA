    "Dictionary": {
        "Entries": {
            "zh-cn": {
                "pb_com_undress_outer_Begin_A_1": "$self$爽快地张开双臂：“好啊，正好有点热。”",
                "pb_com_undress_outer_Begin_A_2": "$self$笑了笑，任由$target$帮自己脱下外套。",
                "pb_com_undress_outer_Begin_B_1": "$self$咬紧牙关，一动不动地站着。",
                "pb_com_undress_outer_Begin_B_2": "$self$攥紧拳头，却没有反抗。",
                "pb_com_undress_outer_Begin_C_1": "“喂，你这是干什么？”$self$皱了皱眉，但还是没有拦着。",
                "pb_com_undress_outer_Begin_C_2": "$self$愣了一下，有些摸不着头脑地配合着。",
                "pb_com_undress_outer_D_1": "$self$睡得很沉，外套被脱下了也毫无察觉。",
                "pb_com_undress_outer_E_1": "$self$凝固在原地，外套被脱下时一动不动。",
                "pb_com_undress_outer_F_1": "“现在不行，等会儿吧。”$self$笑着挡开了$target$的手。",
                "pb_com_undress_outer_F_2": "$self$摇摇头：“这里不太合适。”",
                "pb_com_undress_outer_G_1": "“喂喂，突然干嘛啊！”$self$后退了一步。",
                "pb_com_undress_outer_G_2": "$self$尴尬地挠了挠头：“这个……还是算了吧。”",
                "pb_com_undress_outer_H_1": "“别碰我。”$self$冷冷地甩开了$target$的手。",
                "pb_com_undress_outer_H_2": "$self$恶狠狠地瞪着$target$：“你想干什么？”",
                "pb_com_undress_outer_I_1": "$self$活动了一下肩膀，轻松了不少。",
                "pb_com_undress_outer_I_2": "“谢了。”$self$随手把外套搭在一边。",
                "pb_com_undress_outer_J_1": "$self$阴沉着脸，一言不发。",
                "pb_com_undress_outer_J_2": "$self$低着头，拳头攥得发白。",
                "pb_com_undress_outer_K_1": "$self$有些不自在地整了整剩下的衣服。",
                "pb_com_undress_outer_K_2": "“……只是外套而已。”$self$嘟囔着。",

                "pb_com_undress_inner_Begin_A_1": "$self$挑了挑眉，主动解开了衣扣：“这么着急？”",
                "pb_com_undress_inner_Begin_A_2": "$self$配合地抬起手臂，脸上带着一丝笑意。",
                "pb_com_undress_inner_Begin_B_1": "$self$闭上眼睛，身体僵硬地任由衣服被扒下。",
                "pb_com_undress_inner_Begin_B_2": "$self$的手抬起又放下，终究没有反抗。",
                "pb_com_undress_inner_Begin_C_1": "“真、真要脱？”$self$的耳朵有些发红。",
                "pb_com_undress_inner_Begin_C_2": "$self$别过脸去，任由$target$动手。",
                "pb_com_undress_inner_D_1": "$self$睡得正香，衣服被脱下时只是含糊地嘟囔了一声。",
                "pb_com_undress_inner_E_1": "$self$保持着静止前的表情，对衣服被脱下毫无知觉。",
                "pb_com_undress_inner_F_1": "“这个……晚点再说吧。”$self$按住了衣角。",
                "pb_com_undress_inner_F_2": "$self$苦笑着摇头：“现在真的不行。”",
                "pb_com_undress_inner_G_1": "“你、你在想什么啊！”$self$涨红了脸。",
                "pb_com_undress_inner_G_2": "$self$慌忙后退：“我们还没到那一步吧！”",
                "pb_com_undress_inner_H_1": "“滚开！”$self$一把推开了$target$。",
                "pb_com_undress_inner_H_2": "$self$厌恶地皱起眉头：“想都别想。”",
                "pb_com_undress_inner_I_1": "赤裸着上身的$self$毫不在意地挺了挺胸。",
                "pb_com_undress_inner_I_2": "“怎么样，还满意吗？”$self$笑着问道。",
                "pb_com_undress_inner_J_1": "$self$紧咬着嘴唇，屈辱地别过脸去。",
                "pb_com_undress_inner_J_2": "$self$垂着头，肩膀微微发抖。",
                "pb_com_undress_inner_K_1": "$self$不自在地抱起双臂，避开了$target$的视线。",
                "pb_com_undress_inner_K_2": "“别一直盯着看……”$self$扭过身去。",

                "pb_com_undress_skin_Begin_A_1": "$self$呼吸变得粗重，没有丝毫抗拒。",
                "pb_com_undress_skin_Begin_A_2": "“你可真主动啊。”$self$低声笑道。",
                "pb_com_undress_skin_Begin_B_1": "$self$紧闭双眼，浑身止不住地发抖。",
                "pb_com_undress_skin_Begin_B_2": "$self$死死咬着牙，屈辱地任人摆布。",
                "pb_com_undress_skin_Begin_C_1": "$self$的脸涨得通红，双手不知道该往哪放。",
                "pb_com_undress_skin_Begin_C_2": "“喂……”$self$小声嘀咕着，却没有阻止。",
                "pb_com_undress_skin_D_1": "$self$毫无防备地熟睡着，连最后的贴身衣物也被褪了下来。",
                "pb_com_undress_skin_E_1": "$self$一丝不挂地凝固在原地，对一切毫无知觉。",
                "pb_com_undress_skin_F_1": "“抱歉……这个还是不行。”$self$按住了最后的遮挡。",
                "pb_com_undress_skin_F_2": "$self$红着脸摇头：“再给我点时间。”",
                "pb_com_undress_skin_G_1": "“够了够了！”$self$羞得面红耳赤。",
                "pb_com_undress_skin_G_2": "$self$一把推开$target$：“这也太过分了！”",
                "pb_com_undress_skin_H_1": "“你敢！”$self$的眼神充满了警惕与愤怒。",
                "pb_com_undress_skin_H_2": "$self$狠狠地瞪着$target$，护住了身体。",
                "pb_com_undress_skin_I_1": "一丝不挂的$self$毫不遮掩，目光灼灼地看着$target$。",
                "pb_com_undress_skin_I_2": "“接下来呢？”$self$低声问道。",
                "pb_com_undress_skin_J_1": "$self$用手遮挡着身体，屈辱得说不出话来。",
                "pb_com_undress_skin_J_2": "$self$蜷起身子，眼眶通红。",
                "pb_com_undress_skin_K_1": "$self$满脸通红地遮住下身，尴尬得说不出话。",
                "pb_com_undress_skin_K_2": "“……全被看光了。”$self$捂住了脸。",

                "pb_com_redress_Begin_A_1": "$self$笑着伸出手臂：“被人伺候的感觉还不错。”",
                "pb_com_redress_Begin_A_2": "$self$配合地让$target$帮自己穿上衣服。",
                "pb_com_redress_Begin_B_1": "$self$有些意外，但还是配合着穿上了衣服。",
                "pb_com_redress_Begin_B_2": "“我自己来就行……”$self$嘴上这么说，却没有拒绝。",
                "pb_com_redress_D_1": "$self$仍在熟睡，完全没发现自己被穿上了衣服。",
                "pb_com_redress_E_1": "$self$凝固在原地，被穿好了衣服也毫无知觉。",
                "pb_com_redress_I_1": "$self$整了整衣领，满意地点点头。",
                "pb_com_redress_I_2": "“谢了。”$self$随口道谢。",
                "pb_com_redress_K_1": "$self$松了口气，整理了一下衣服。",
                "pb_com_redress_K_2": "“……谢了。”$self$别扭地说了一句。"
            },
            "en-us": {
                "pb_com_undress_outer_Begin_A_1": "$self$ spreads his arms easily. \"Sure, it's a bit warm anyway.\"",
                "pb_com_undress_outer_Begin_A_2": "$self$ grins and lets $target$ take off his jacket.",
                "pb_com_undress_outer_Begin_B_1": "$self$ clenches his jaw and stands perfectly still.",
                "pb_com_undress_outer_Begin_B_2": "$self$ balls his fists, but doesn't resist.",
                "pb_com_undress_outer_Begin_C_1": "\"Hey, what are you doing?\" $self$ frowns, but doesn't stop it.",
                "pb_com_undress_outer_Begin_C_2": "$self$ pauses, puzzled, but goes along with it.",
                "pb_com_undress_outer_D_1": "$self$ sleeps soundly, not noticing his jacket coming off.",
                "pb_com_undress_outer_E_1": "$self$ stays frozen in place as his jacket is taken off.",
                "pb_com_undress_outer_F_1": "\"Not now, later.\" $self$ laughs, brushing $target$'s hand away.",
                "pb_com_undress_outer_F_2": "$self$ shakes his head. \"This isn't the right place.\"",
                "pb_com_undress_outer_G_1": "\"Whoa, what's this all of a sudden!\" $self$ takes a step back.",
                "pb_com_undress_outer_G_2": "$self$ scratches his head awkwardly. \"Uh... let's not.\"",
                "pb_com_undress_outer_H_1": "\"Don't touch me.\" $self$ coldly shakes off $target$'s hand.",
                "pb_com_undress_outer_H_2": "$self$ glares at $target$. \"What do you think you're doing?\"",

{
    "Events": {
        "list": [
            {
                "ID": "OnRentPaid",
                "SelfValidator": {
                    "chara_conditions": [
                        {"parameters":["exists"]}
                    ]
                },
                "events": [
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "rent", "line": "OnRentPaid_rent", "tooltip": "target character: $target.name$", "nextEntryLabel": "check_resumed" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "maintenance", "line": "OnRentPaid_maintenance", "tooltip": "target character: $target.name$", "nextEntryLabel": "check_resumed" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "both", "line": "OnRentPaid_both", "tooltip": "target character: $target.name$", "nextEntryLabel": "check_resumed" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "generic", "line": "OnRentPaid_generic", "tooltip": "target character: $target.name$", "nextEntryLabel": "check_resumed" },

                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "rent_payee", "line": "OnRentPaid_rent_payee", "tooltip": "target character: $target.name$", "nextEntryLabel": "check_resumed" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "maintenance_payee", "line": "OnRentPaid_maintenance_payee", "tooltip": "target character: $target.name$", "nextEntryLabel": "check_resumed" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "both_payee", "line": "OnRentPaid_both_payee", "tooltip": "target character: $target.name$", "nextEntryLabel": "check_resumed" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "generic_payee", "line": "OnRentPaid_generic_payee", "tooltip": "target character: $target.name$", "nextEntryLabel": "check_resumed" },

                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "check_resumed",
                        "options": [
                            {
                                "option": "resumed append string set - jump to the resumed trailer line",
                                "Results": [
                                    { "Type": "ExistAppendStrings", "arguments": ["resumed"] },
                                    { "Type": "JumpToLabel", "arguments": ["", "resumed_trailer"] }
                                ]
                            },
                            {
                                "option": "not resumed - nothing more to say",
                                "Results": [ { "Type": "EventEnd" } ]
                            }
                        ]
                    },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "resumed_trailer", "isLast": true, "line": "OnRentPaid_resumed", "tooltip": "target character: $target.name$" }
                ]
            },
            {
                "ID": "OnRentFailed",
                "SelfValidator": {
                    "chara_conditions": [
                        {"parameters":["exists"]}
                    ]
                },
                "events": [
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "rent", "isLast": true, "line": "OnRentFailed_rent", "tooltip": "target character: $target.name$" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "maintenance", "isLast": true, "line": "OnRentFailed_maintenance", "tooltip": "target character: $target.name$" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "both", "isLast": true, "line": "OnRentFailed_both", "tooltip": "target character: $target.name$" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "generic", "isLast": true, "line": "OnRentFailed_generic", "tooltip": "target character: $target.name$" },

                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "rent_payee", "isLast": true, "line": "OnRentFailed_rent_payee", "tooltip": "target character: $target.name$" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "maintenance_payee", "isLast": true, "line": "OnRentFailed_maintenance_payee", "tooltip": "target character: $target.name$" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "both_payee", "isLast": true, "line": "OnRentFailed_both_payee", "tooltip": "target character: $target.name$" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "generic_payee", "isLast": true, "line": "OnRentFailed_generic_payee", "tooltip": "target character: $target.name$" }
                ]
            }
        ]
    },
    "Dictionary": {
        "Entries": {
            "zh-cn": {
                "OnRentPaid": "租金事件 - 已支付",
                "OnRentPaid_rent": "$factionName$已向$counterpartName$支付$sourceName$的租金（$amount$）。",
                "OnRentPaid_maintenance": "$factionName$已支付$sourceName$的房屋维护费（$amount$）。",
                "OnRentPaid_both": "$factionName$已向$counterpartName$支付$sourceName$的租金与房屋维护费（$amount$）。",
                "OnRentPaid_generic": "$factionName$已还清拖欠的租金（$amount$）。",
                "OnRentPaid_resumed": "此前因欠款而中断的服务已恢复。",

                "OnRentPaid_rent_payee": "$factionName$已从$counterpartName$处收取$sourceName$的租金（$amount$）。",
                "OnRentPaid_maintenance_payee": "$factionName$已从$counterpartName$处收取$sourceName$的房屋维护费（$amount$）。",
                "OnRentPaid_both_payee": "$factionName$已从$counterpartName$处收取$sourceName$的租金与房屋维护费（$amount$）。",
                "OnRentPaid_generic_payee": "$factionName$已从$counterpartName$处收取拖欠的租金（$amount$）。",

                "OnRentFailed": "租金事件 - 未支付",
                "OnRentFailed_rent": "$factionName$未能向$counterpartName$支付$sourceName$的租金：需要$amount$，但仅有$available$。",
                "OnRentFailed_maintenance": "$factionName$未能支付$sourceName$的房屋维护费：需要$amount$，但仅有$available$。",
                "OnRentFailed_both": "$factionName$未能向$counterpartName$支付$sourceName$的租金与房屋维护费：需要$amount$，但仅有$available$。",
                "OnRentFailed_generic": "$factionName$未能还清拖欠的租金：需要$amount$，但仅有$available$。",

                "OnRentFailed_rent_payee": "$factionName$本期未能从$counterpartName$处收到$sourceName$的租金：需要$amount$，但对方仅有$available$。",
                "OnRentFailed_maintenance_payee": "$factionName$本期未能从$counterpartName$处收到$sourceName$的房屋维护费：需要$amount$，但对方仅有$available$。",
                "OnRentFailed_both_payee": "$factionName$本期未能从$counterpartName$处收到$sourceName$的租金与房屋维护费：需要$amount$，但对方仅有$available$。",
                "OnRentFailed_generic_payee": "$factionName$未能从$counterpartName$处收到拖欠的租金：需要$amount$，但对方仅有$available$。"
            },
            "en-us": {
                "OnRentPaid": "Rent Event - Paid",
                "OnRentPaid_rent": "$factionName$ paid $sourceName$'s rent to $counterpartName$ ($amount$).",
                "OnRentPaid_maintenance": "$factionName$ paid $sourceName$'s maintenance fee ($amount$).",
                "OnRentPaid_both": "$factionName$ paid $sourceName$'s rent and maintenance to $counterpartName$ ($amount$).",
                "OnRentPaid_generic": "$factionName$ paid off an outstanding rent balance ($amount$).",
                "OnRentPaid_resumed": "Service, previously interrupted by the missed payment, has resumed.",

                "OnRentPaid_rent_payee": "$factionName$ collected $sourceName$'s rent from $counterpartName$ ($amount$).",
                "OnRentPaid_maintenance_payee": "$factionName$ collected $sourceName$'s maintenance fee from $counterpartName$ ($amount$).",
                "OnRentPaid_both_payee": "$factionName$ collected $sourceName$'s rent and maintenance from $counterpartName$ ($amount$).",
                "OnRentPaid_generic_payee": "$factionName$ collected an outstanding rent balance from $counterpartName$ ($amount$).",

                "OnRentFailed": "Rent Event - Unpaid",
                "OnRentFailed_rent": "$factionName$ failed to pay $sourceName$'s rent to $counterpartName$: $amount$ needed, but only has $available$.",
                "OnRentFailed_maintenance": "$factionName$ failed to pay $sourceName$'s maintenance fee: $amount$ needed, but only has $available$.",
                "OnRentFailed_both": "$factionName$ failed to pay $sourceName$'s rent and maintenance to $counterpartName$: $amount$ needed, but only has $available$.",
                "OnRentFailed_generic": "$factionName$ failed to pay off an outstanding rent balance: $amount$ needed, but only has $available$.",

                "OnRentFailed_rent_payee": "$factionName$ did not receive $sourceName$'s rent from $counterpartName$ this cycle: $amount$ was due, but they only have $available$.",
                "OnRentFailed_maintenance_payee": "$factionName$ did not receive $sourceName$'s maintenance fee from $counterpartName$ this cycle: $amount$ was due, but they only have $available$.",
                "OnRentFailed_both_payee": "$factionName$ did not receive $sourceName$'s rent and maintenance from $counterpartName$ this cycle: $amount$ was due, but they only have $available$.",
                "OnRentFailed_generic_payee": "$factionName$ did not receive the outstanding rent balance from $counterpartName$: $amount$ was due, but they only have $available$."
            }
        }
    }
}

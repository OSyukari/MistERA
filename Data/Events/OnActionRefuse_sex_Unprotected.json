                        "options": [
                            {
                                "option": "event_OnAPRefuse_Unprotected_op_ignore",
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "br_push" ] } ]
                            },
                            {
                                "option": "event_OnAPRefuse_Unprotected_op_giveup",
                                "isDefaultCancel": true,
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "br_end" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "br_choice_plain",
                        "UISpec": { "portraitRefKey": "evTarget", "selfTags": [ "worry" ] },
                        "question": "event_OnAPRefuse_Unprotected_q_plain",
                        "loadOptionsKey": "demandOptions",
                        "options": [
                            {
                                "option": "event_OnAPRefuse_Unprotected_op_ignore",
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "br_push" ] } ]
                            },
                            {
                                "option": "event_OnAPRefuse_Unprotected_op_giveup",
                                "isDefaultCancel": true,
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "br_end" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "br_condom_self",
                        "UISpec": { "portraitRefKey": "evTarget", "selfTags": [ "relieved" ] },

{
    "Events": {
        "list": [
            {
                "ID": "OnMembershipFeePaid",
                "SelfValidator": {
                    "chara_conditions": [
                        {"parameters":["exists"]}
                    ]
                },
                "events": [
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "line": "OnMembershipFeePaid_paid", "nextEntryLabel": "check_resumed" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "payee", "line": "OnMembershipFeePaid_paid_payee", "nextEntryLabel": "check_resumed" },

                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "check_resumed",
                        "options": [
                            {
                                "option": "resumed append string set - jump to the resumed trailer line",
                                "Results": [
                                    { "Type": "ExistAppendStrings", "arguments": ["resumed"] },
                                    { "Type": "JumpToLabel", "arguments": ["", "resumed_trailer"] }
                                ]
                            },
                            {
                                "option": "not resumed - nothing more to say",
                                "Results": [ { "Type": "EventEnd" } ]
                            }
                        ]
                    },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "resumed_trailer", "isLast": true, "line": "OnMembershipFeePaid_resumed" }
                ]
            },
            {
                "ID": "OnMembershipFeeFailed",
                "SelfValidator": {
                    "chara_conditions": [
                        {"parameters":["exists"]}
                    ]
                },
                "events": [
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "isLast": true, "line": "OnMembershipFeeFailed_failed" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "payee", "isLast": true, "line": "OnMembershipFeeFailed_failed_payee" }
                ]
            }
        ]
    },
    "Dictionary": {
        "Entries": {
            "zh-cn": {
                "OnMembershipFeePaid": "会员费事件 - 已支付",
                "OnMembershipFeePaid_paid": "$factionName$已向$counterpartName$支付$target.name$的$feeName$（$amount$）。",
                "OnMembershipFeePaid_resumed": "此前因欠款而中断的服务已恢复。",
                "OnMembershipFeePaid_paid_payee": "$factionName$已从$counterpartName$处收到$target.name$的$feeName$（$amount$）。",

                "OnMembershipFeeFailed": "会员费事件 - 未支付",
                "OnMembershipFeeFailed_failed": "$factionName$未能向$counterpartName$支付$target.name$的$feeName$：需要$amount$，但仅有$available$。",
                "OnMembershipFeeFailed_failed_payee": "$factionName$未能从$counterpartName$处收到$target.name$的$feeName$：需要$amount$，但对方仅有$available$。"
            },
            "en-us": {
                "OnMembershipFeePaid": "Membership Fee Event - Paid",
                "OnMembershipFeePaid_paid": "$factionName$ paid $target.name$'s $feeName$ to $counterpartName$ ($amount$).",
                "OnMembershipFeePaid_resumed": "Service, previously interrupted by the missed payment, has resumed.",
                "OnMembershipFeePaid_paid_payee": "$factionName$ received $target.name$'s $feeName$ from $counterpartName$ ($amount$).",

                "OnMembershipFeeFailed": "Membership Fee Event - Unpaid",
                "OnMembershipFeeFailed_failed": "$factionName$ failed to pay $target.name$'s $feeName$ to $counterpartName$: $amount$ needed, but only has $available$.",
                "OnMembershipFeeFailed_failed_payee": "$factionName$ did not receive $target.name$'s $feeName$ from $counterpartName$: $amount$ was due, but they only have $available$."
            }
        }
    }
}

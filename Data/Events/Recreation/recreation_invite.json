{
    "_doc": "Fired from code (RecreationUtility.StartPlayerPrompt - Docs/Activities/Plan_ActivityPlayerPrompt.md), no trigger, the player only: the player's one question box per activity, sent from the update's batch once every NPC answered, merged with the fee requests the player approves for the same activity. Recreation_Invite = someone picked the player as an invitee (the host's invitation, or a participant extending it); Recreation_OrganizationInvite = an organization's call; Recreation_PublicInvite = a public session (posted fixed offer, performance audience) the player sees - nobody invites, the activity asks. Self = the player; Targets.inviter = who invites them (Recreation_Invite only); $inviteText$ = the activity line, who is coming, who else is invited, role / required; $publicNoticeText$ = the public activity line + attendees from the player's homes (others counted), $publicOthers$ = the other attendees (the notice line's tooltip). The prompt is carried only by the event's runtime callbacks (events are never saved): ExecuteCallback buildOptions = the loaded options ([接受] / [支付并参加], [支付但不参加] when NPC fees are attached - disabled with the reason when not possible) + $inviteFeeText$ (own fee, who each payer pays for, total), $inviteMandatoryText$ (refusing cancels it) and $inviteConflictText$ (clashes with the player's bookings), built just before the question shows; ExecuteCallback decline = refuse (declines the attached fees too; final).",
    "Events": {
        "list": [
            {
                "ID": "Recreation_Invite",
                "allowDuplicate": true,
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "_comment": "Builds the Accept option and the clashes text from the current state, then asks.",
                        "options": [
                            {
                                "option": "_build",
                                "Results": [
                                    { "Type": "ExecuteCallbackPermissive", "arguments": [ "buildOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "ask" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "ask",
                        "_comment": "The loaded Accept answers yes through its callback (disabled with the reason when a clash can't be cancelled); Decline answers no.",
                        "UISpec": { "portraitRefKey": "inviter" },
                        "question": "Recreation_Invite_question",
                        "loadOptionsKey": "inviteOptions",
                        "loadOptionsResults": [ { "Type": "JumpToLabel", "arguments": [ "", "end" ] } ],
                        "options": [
                            {
                                "option": "Recreation_Invite_decline",
                                "isDefaultCancel": true,
                                "Results": [
                                    { "Type": "ExecuteCallbackPermissive", "arguments": [ "decline" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "end" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "end",
                        "line": "",
                        "isLast": true
                    }
                ]
            },
            {
                "ID": "Recreation_OrganizationInvite",
                "allowDuplicate": true,
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "_comment": "Builds the Accept option and the clashes text from the current state, then asks.",
                        "options": [
                            {
                                "option": "_build",
                                "Results": [
                                    { "Type": "ExecuteCallbackPermissive", "arguments": [ "buildOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "ask" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "ask",
                        "_comment": "The loaded Accept answers yes through its callback (disabled with the reason when a clash can't be cancelled); Decline answers no.",
                        "question": "Recreation_OrganizationInvite_question",
                        "loadOptionsKey": "inviteOptions",
                        "loadOptionsResults": [ { "Type": "JumpToLabel", "arguments": [ "", "end" ] } ],
                        "options": [
                            {
                                "option": "Recreation_Invite_decline",
                                "isDefaultCancel": true,
                                "Results": [
                                    { "Type": "ExecuteCallbackPermissive", "arguments": [ "decline" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "end" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "end",
                        "line": "",
                        "isLast": true
                    }
                ]
            },
            {
                "ID": "Recreation_PublicInvite",
                "allowDuplicate": true,
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "_comment": "Builds the options, fee and clashes text from the current state, then shows the notice and asks.",
                        "options": [
                            {
                                "option": "_build",
                                "Results": [
                                    { "Type": "ExecuteCallbackPermissive", "arguments": [ "buildOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "notice" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "notice",
                        "_comment": "The activity and its attendees: the player's housemates by name, the others counted - hover for their names.",
                        "line": "Recreation_PublicInvite_notice",
                        "tooltip": "Recreation_PublicInvite_others"
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "ask",
                        "_comment": "The loaded participate / pay-only options answer through their callbacks (disabled with the reason when not possible); Refuse answers no.",
                        "question": "Recreation_PublicInvite_question",
                        "loadOptionsKey": "inviteOptions",
                        "loadOptionsResults": [ { "Type": "JumpToLabel", "arguments": [ "", "end" ] } ],
                        "options": [
                            {
                                "option": "Recreation_Invite_decline",
                                "isDefaultCancel": true,
                                "Results": [
                                    { "Type": "ExecuteCallbackPermissive", "arguments": [ "decline" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "end" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "end",
                        "line": "",
                        "isLast": true
                    }
                ]
            }
        ]
    },
    "Dictionary": {
        "Entries": {
            "zh-cn": {
                "Recreation_Invite_question": "$inviter.name$邀请$self.name$一起去$activityName$：\n$inviteText$$inviteFeeText$$inviteMandatoryText$$inviteConflictText$",
                "Recreation_OrganizationInvite_question": "$organizationName$邀请$self.name$参加$activityName$：\n$inviteText$$inviteFeeText$$inviteMandatoryText$$inviteConflictText$",
                "Recreation_PublicInvite_notice": "活动公告：\n$publicNoticeText$",
                "Recreation_PublicInvite_others": "$publicOthers$",
                "Recreation_PublicInvite_question": "$self.name$要参加$activityName$吗？$inviteFeeText$$inviteMandatoryText$$inviteConflictText$",
                "Recreation_Invite_decline": "拒绝"
            }
        }
    }
}

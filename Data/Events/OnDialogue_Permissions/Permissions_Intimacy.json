{
    "_doc": {
        "purpose": "OnDialogue_Permissions request events (Docs/Interactions/Step06FPermissionsImplementationPlan.md, P6). Event ID = permission ID: the dialogue menu box (tab_dialogue.Button_PermissionEvent) reads that permission from the talked-to person (person, granter) toward the player (self, holder), shows its state and disables the request while it is already in effect.",
        "flow": "canRequestPermission uses shared automatic/menu eligibility, without a shipped sexual_partner gate. acceptsPermissionRequest uses adjusted deterministic requirements. GrantPermission fourth argument Request rechecks that decision and requestGrantType; sexual_partner selects Normal lifetime, otherwise today only. Kojo fetch-then-jump and narrative are unchanged. Status lines show $permission_grant_type$ even when kojo is missing.",
        "kojo": "One kojo set per permission, no shared fallback: Permission_[id]_Request / _Granted / _Refused in Data/Personality/personality_default|personality_base/OnDialogue/Permission_[id].json. Permission_[id]_Granted is also said when a command's request phase grants the permission (EvaluationPackage.RequestMissingPermissions).",
        "nsfw": "The sex_* requests live in Permissions_Sex.json so safe mode skips them by file name."
    },
    "Events": {
        "list": [
            {
                "ID": "permission_intimacy_low",
                "allowDuplicate": false,
                "trigger": "OnDialogue_Permissions",
                "UISpec": { "displayMode": "AVG" },
                "SelfValidator": { "chara_conditions": [ { "parameters": [ "exists" ] }, { "parameters": [ "isPlayer" ] } ] },
                "TargetValidators": [
                    {
                        "refkeys": [ "person" ],
                        "baseScope": "CurrentTarget",
                        "chara_conditions": [ { "parameters": [ "exists" ] }, { "parameters": [ "excludePlayer" ] }, { "parameters": [ "canRequestPermission", "permission_intimacy_low", "self" ] } ],
                        "minTargetCount": 1
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "start",
                        "options": [
                            {
                                "option": "_kojo",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "person", "self", "permission_intimacy_low_Request", "kojo_ask" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "ask" ] }
                                ]
                            },
                            { "option": "_plain", "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "ask_plain" ] } ] }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "ask",
                        "UISpec": { "portraitRefKey": "person" },
                        "question": "permission_intimacy_low_question",
                        "options": [
                            { "option": "Permission_Request_confirm", "isDefaultAccept": true, "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "decide" ] } ] },
                            { "option": "Permission_Request_cancel", "isDefaultCancel": true, "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "end" ] } ] }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "ask_plain",
                        "UISpec": { "portraitRefKey": "person" },
                        "question": "permission_intimacy_low_question_plain",
                        "options": [
                            { "option": "Permission_Request_confirm", "isDefaultAccept": true, "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "decide" ] } ] },
                            { "option": "Permission_Request_cancel", "isDefaultCancel": true, "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "end" ] } ] }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "decide",
                        "options": [
                            {
                                "option": "_accept",
                                "target_chara_conditions": { "person": [ { "parameters": [ "acceptsPermissionRequest", "permission_intimacy_low", "self" ] } ] },
                                "Results": [
                                    { "Type": "GrantPermission", "arguments": [ "person", "self", "permission_intimacy_low", "Request" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "accept_kojo" ] }
                                ]
                            },
                            { "option": "_refuse", "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "refuse_kojo" ] } ] }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "accept_kojo",
                        "options": [
                            {
                                "option": "_kojo",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "person", "self", "permission_intimacy_low_Granted", "kojo_reply" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "accept_reply" ] }
                                ]
                            },
                            { "option": "_plain", "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "accept_status" ] } ] }
                        ]
                    },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "accept_reply", "UISpec": { "portraitRefKey": "person" }, "line": "Permission_Request_reply", "nextEntryLabel": "accept_status" },
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "accept_status",
                        "options": [
                            { "option": "_normal", "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "granted" ] } ] }
                        ]
                    },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "granted", "UISpec": { "portraitRefKey": "person" }, "line": "permission_intimacy_low_granted", "isLast": true },
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "refuse_kojo",
                        "options": [
                            {
                                "option": "_kojo",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "person", "self", "permission_intimacy_low_Refused", "kojo_reply" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "refuse_reply" ] }
                                ]
                            },
                            { "option": "_plain", "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "refused" ] } ] }
                        ]
                    },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "refuse_reply", "UISpec": { "portraitRefKey": "person" }, "line": "Permission_Request_reply", "nextEntryLabel": "refused" },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "refused", "UISpec": { "portraitRefKey": "person" }, "line": "Permission_Request_refused", "isLast": true },
                    { "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp", "label": "end", "line": "", "isLast": true }
                ]
            },

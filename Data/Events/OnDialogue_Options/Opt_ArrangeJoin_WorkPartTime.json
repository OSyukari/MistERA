{
    "_doc": "Arrange (or quit) a part-time job - one of the tag-driven arrange events, see Opt_ArrangeJoin.json for the shared flow and keys. Same flow as Opt_ArrangeJoin_StudentFullTime: holding a post opens on quitting it, then offers a new one.",
    "Events": {
        "list": [
            {
                "ID": "Opt_ArrangeJoin_WorkPartTime",
                "_comment": "Arrange (or quit) a part-time job for one of the player's own people (sharesHomeFaction). Searches every reachable faction listing a 'memberType_work_partTime' post in its joinableMemberTypes; a parent post is offered once - labelled '<faction>: <post>', its shifts listed in the tooltip - and joins its FIRST shift (shift changes are done in the Management UI). Join/leave logic: JoinHandler_WorkPost / LeaveHandler_WorkPost on the post. Independent of the full-time option: a character may hold both kinds of job.",
                "allowDuplicate": false,
                "trigger": "OnDialogue_Options",
                "UISpec": { "displayMode": "AVG" },
                "SelfValidator": {
                    "chara_conditions": [
                        { "parameters": [ "exists" ] },
                        { "parameters": [ "isPlayer" ] }
                    ]
                },
                "TargetValidators": [
                    {
                        "refkeys": [ "worker" ],
                        "baseScope": "CurrentTarget",
                        "chara_conditions": [
                            { "parameters": [ "exists" ] },
                            { "parameters": [ "excludePlayer" ] },
                            { "parameters": [ "sharesHomeFaction" ] },
                            { "parameters": [ "canArrangeJoinByTag", "memberType_work_partTime" ] }
                        ],
                        "minTargetCount": 1
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "_comment": "Join or leave: holding a part-time post with leave options -> leave branch, else join. The two options also fetch different opening reactions into $kojo_start$ (shown above both question texts): _held already works part-time (kojo Opt_ArrangeJoin_WorkPartTime_start_employed), _join does not (kojo Opt_ArrangeJoin_WorkPartTime_start).",
                        "options": [
                            {
                                "option": "_held",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_WorkPartTime_start_employed", "kojo_start" ] },
                                    { "Type": "LeaveHeldFactionsByTag", "arguments": [ "leaveOptions", "worker", "memberType_work_partTime", "heldMemberships" ] },
                                    { "Type": "ExistStoredOptions", "arguments": [ "leaveOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "leave_ask" ] }
                                ]
                            },
                            {
                                "option": "_join",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_WorkPartTime_start", "kojo_start" ] },
                                    { "Type": "JoinReachableFactionsByTag", "arguments": [ "arrangeOptions", "worker", "memberType_work_partTime" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_ask" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "leave_ask",
                        "_comment": "Picking a loaded leave option runs its leave callback, then (loadOptionsResults) fetches the quitting reaction kojo and shows it, then goes on to rejoin.",
                        "UISpec": { "portraitRefKey": "worker" },
                        "question": "Opt_ArrangeJoin_WorkPartTime_leave_question",
                        "loadOptionsKey": "leaveOptions",
                        "loadOptionsResults": [
                            { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_WorkPartTime_quit", "kojo_changed" ] },
                            { "Type": "JumpToLabel", "arguments": [ "", "leave_changed" ] }
                        ],
                        "options": [
                            {
                                "option": "Opt_ArrangeJoin_Work_leave_cancel",
                                "isDefaultCancel": true,
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_WorkPartTime_bye", "kojo_bye" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_cancel" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "leave_changed",
                        "_comment": "The quitting reaction ($kojo_changed$, fetched by leave_ask's loadOptionsResults), then the rejoin branch.",
                        "UISpec": { "portraitRefKey": "worker" },
                        "line": "Opt_ArrangeJoin_WorkPartTime_left",
                        "nextEntryLabel": "rejoin"
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "rejoin",
                        "_comment": "After quitting: rebuild the job options. None (e.g. nothing reachable right now) -> fetch the farewell kojo and end; the player can run the option again.",
                        "options": [
                            {
                                "option": "_has_options",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_WorkPartTime_start", "kojo_start" ] },
                                    { "Type": "JoinReachableFactionsByTag", "arguments": [ "arrangeOptions", "worker", "memberType_work_partTime" ] },
                                    { "Type": "ExistStoredOptions", "arguments": [ "arrangeOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_ask" ] }
                                ]
                            },
                            {
                                "option": "_no_options",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_WorkPartTime_bye", "kojo_bye" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_cancel" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "arrange_ask",
                        "UISpec": { "portraitRefKey": "worker" },
                        "question": "Opt_ArrangeJoin_WorkPartTime_question",
                        "loadOptionsKey": "arrangeOptions",
                        "loadOptionsResults": [
                            { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_WorkPartTime_hired", "kojo_changed" ] },
                            { "Type": "JumpToLabel", "arguments": [ "", "arrange_done" ] }
                        ],
                        "options": [
                            {
                                "option": "Opt_ArrangeJoin_cancel",
                                "isDefaultCancel": true,
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_WorkPartTime_bye", "kojo_bye" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_cancel" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "arrange_done",
                        "_comment": "Reached by picking a loaded option (the question's loadOptionsResults jump here); $kojo_changed$ is the hiring reaction fetched there, $lastFactionChange$ the per-change capture of AppendFactionChange (MemberJoinHandler.LastFactionChangeStringKey - who is now what).",
                        "UISpec": { "portraitRefKey": "worker" },
                        "line": "Opt_ArrangeJoin_WorkPartTime_done",
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "arrange_cancel",
                        "_comment": "The player cancelled (or nothing is reachable after quitting): show the farewell kojo ($kojo_bye$, fetched by the cancel paths) and close.",
                        "UISpec": { "portraitRefKey": "worker" },
                        "line": "Opt_ArrangeJoin_WorkPartTime_bye",
                        "isLast": true
                    }
                ]
            }
        ]
    },
    "Dictionary": {
        "Entries": {
            "zh-cn": {
                "Opt_ArrangeJoin_WorkPartTime": "安排兼职工作",
                "Opt_ArrangeJoin_WorkPartTime_question": "$kojo_start$\n要给$worker.name$安排哪里的兼职？",
                "Opt_ArrangeJoin_WorkPartTime_leave_question": "$kojo_start$\n$worker.name$已经在做$heldMemberships$的兼职了。要让$worker.name$辞掉吗？",
                "Opt_ArrangeJoin_WorkPartTime_done": "$kojo_changed$\n\n已经为$worker.name$办好了兼职入职手续。\n$lastFactionChange$",
                "Opt_ArrangeJoin_WorkPartTime_left": "$kojo_changed$\n\n已经为$worker.name$办好了辞职手续。\n$lastFactionChange$",
                "Opt_ArrangeJoin_WorkPartTime_bye": "$kojo_bye$"
            }
        }
    }
}

{
    "_doc": "Arrange (or withdraw from) full-time school enrollment - one of the tag-driven arrange events, see Opt_ArrangeJoin.json for the shared flow and keys.",
    "Events": {
        "list": [
            {
                "ID": "Opt_ArrangeJoin_StudentFullTime",
                "_comment": "Arrange (or withdraw from) full-time school enrollment for one of the player's own people (sharesHomeFaction). Searches every reachable faction listing a 'memberType_student_fullTime' membertype in its joinableMemberTypes, labelled '<faction>: <membertype>'. Join/leave logic: JoinHandler_WorkPost / LeaveHandler_WorkPost on the membertype (enrollment is a work faction).",
                "allowDuplicate": false,
                "trigger": "OnDialogue_Options",
                "UISpec": { "displayMode": "AVG" },
                "SelfValidator": {
                    "chara_conditions": [
                        { "parameters": [ "exists" ] },
                        { "parameters": [ "isPlayer" ] }
                    ]
                },
                "TargetValidators": [
                    {
                        "refkeys": [ "worker" ],
                        "baseScope": "CurrentTarget",
                        "chara_conditions": [
                            { "parameters": [ "exists" ] },
                            { "parameters": [ "excludePlayer" ] },
                            { "parameters": [ "sharesHomeFaction" ] },
                            { "parameters": [ "canArrangeJoinByTag", "memberType_student_fullTime" ] }
                        ],
                        "minTargetCount": 1
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "_comment": "Join or leave: enrolled somewhere with leave options -> leave branch, else join. The two options also fetch different opening reactions into $kojo_start$ (shown above both question texts): _held is already enrolled (kojo Opt_ArrangeJoin_StudentFullTime_start_enrolled - transfer/withdraw context), _join is not (kojo Opt_ArrangeJoin_StudentFullTime_start - fresh enrollment context).",
                        "options": [
                            {
                                "option": "_held",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_StudentFullTime_start_enrolled", "kojo_start" ] },
                                    { "Type": "LeaveHeldFactionsByTag", "arguments": [ "leaveOptions", "worker", "memberType_student_fullTime", "heldMemberships" ] },
                                    { "Type": "ExistStoredOptions", "arguments": [ "leaveOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "leave_ask" ] }
                                ]
                            },
                            {
                                "option": "_join",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_StudentFullTime_start", "kojo_start" ] },
                                    { "Type": "JoinReachableFactionsByTag", "arguments": [ "arrangeOptions", "worker", "memberType_student_fullTime" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_ask" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "leave_ask",
                        "_comment": "Picking a loaded leave option runs its leave callback, then (loadOptionsResults) fetches the withdrawal reaction kojo and shows it, then goes on to rejoin.",
                        "UISpec": { "portraitRefKey": "worker" },
                        "question": "Opt_ArrangeJoin_StudentFullTime_leave_question",
                        "loadOptionsKey": "leaveOptions",
                        "loadOptionsResults": [
                            { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_StudentFullTime_withdrawn", "kojo_changed" ] },
                            { "Type": "JumpToLabel", "arguments": [ "", "leave_changed" ] }
                        ],
                        "options": [
                            {
                                "option": "Opt_ArrangeJoin_Work_leave_cancel",
                                "isDefaultCancel": true,
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_StudentFullTime_bye", "kojo_bye" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_cancel" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "leave_changed",
                        "_comment": "The withdrawal reaction ($kojo_changed$, fetched by leave_ask's loadOptionsResults), then the rejoin branch.",
                        "UISpec": { "portraitRefKey": "worker" },
                        "line": "Opt_ArrangeJoin_StudentFullTime_left",
                        "nextEntryLabel": "rejoin"
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "rejoin",
                        "_comment": "After withdrawing: rebuild the school options. None (e.g. nothing reachable right now) -> fetch the farewell kojo and end; the player can run the option again.",
                        "options": [
                            {
                                "option": "_has_options",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_StudentFullTime_start", "kojo_start" ] },
                                    { "Type": "JoinReachableFactionsByTag", "arguments": [ "arrangeOptions", "worker", "memberType_student_fullTime" ] },
                                    { "Type": "ExistStoredOptions", "arguments": [ "arrangeOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_ask" ] }
                                ]
                            },
                            {
                                "option": "_no_options",
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_StudentFullTime_bye", "kojo_bye" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_cancel" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "arrange_ask",
                        "UISpec": { "portraitRefKey": "worker" },
                        "question": "Opt_ArrangeJoin_StudentFullTime_question",
                        "loadOptionsKey": "arrangeOptions",
                        "loadOptionsResults": [
                            { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_StudentFullTime_enrolled", "kojo_changed" ] },
                            { "Type": "JumpToLabel", "arguments": [ "", "arrange_done" ] }
                        ],
                        "options": [
                            {
                                "option": "Opt_ArrangeJoin_cancel",
                                "isDefaultCancel": true,
                                "Results": [
                                    { "Type": "GetKojoEntry", "arguments": [ "worker", "self", "Opt_ArrangeJoin_StudentFullTime_bye", "kojo_bye" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_cancel" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "arrange_done",
                        "_comment": "Reached by picking a loaded option (the question's loadOptionsResults jump here); $kojo_changed$ is the enrollment reaction fetched there, $lastFactionChange$ the per-change capture of AppendFactionChange (MemberJoinHandler.LastFactionChangeStringKey - who is now what).",
                        "UISpec": { "portraitRefKey": "worker" },
                        "line": "Opt_ArrangeJoin_StudentFullTime_done",
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "arrange_cancel",
                        "_comment": "The player cancelled (or nothing is reachable after withdrawing): show the farewell kojo ($kojo_bye$, fetched by the cancel paths) and close.",
                        "UISpec": { "portraitRefKey": "worker" },
                        "line": "Opt_ArrangeJoin_StudentFullTime_bye",
                        "isLast": true
                    }
                ]
            }
        ]
    },
    "Dictionary": {
        "Entries": {
            "zh-cn": {
                "Opt_ArrangeJoin_StudentFullTime": "安排入学",
                "Opt_ArrangeJoin_StudentFullTime_question": "$kojo_start$\n要让$worker.name$去哪里上学？",
                "Opt_ArrangeJoin_StudentFullTime_leave_question": "$kojo_start$\n$worker.name$已经是$heldMemberships$了。要让$worker.name$退学吗？",
                "Opt_ArrangeJoin_StudentFullTime_done": "$kojo_changed$\n\n已经为$worker.name$办好了入学手续。\n$lastFactionChange$",
                "Opt_ArrangeJoin_StudentFullTime_left": "$kojo_changed$\n\n已经为$worker.name$办好了退学手续。\n$lastFactionChange$",
                "Opt_ArrangeJoin_StudentFullTime_bye": "$kojo_bye$",
                "student_post_leaveOption": "让$name$退学"
            }
        }
    }
}

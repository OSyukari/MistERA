{
    "_doc": "Arrange (or quit) a full-time job - one of the tag-driven arrange events, see Opt_ArrangeJoin.json for the shared flow and keys.",
    "Events": {
        "list": [
            {
                "ID": "Opt_ArrangeJoin_WorkFullTime",
                "_comment": "Arrange (or quit) a full-time job for one of the player's own people (sharesHomeFaction). Searches every reachable faction listing a 'memberType_work_fullTime' post in its joinableMemberTypes; a parent post is offered once - labelled '<faction>: <post>', its shifts listed in the tooltip - and joins its FIRST shift (shift changes are done in the Management UI). Join/leave logic: JoinHandler_WorkPost / LeaveHandler_WorkPost on the post.",
                "allowDuplicate": false,
                "trigger": "OnDialogue_Options",
                "UISpec": { "displayMode": "AVG" },
                "SelfValidator": {
                    "chara_conditions": [
                        { "parameters": [ "exists" ] },
                        { "parameters": [ "isPlayer" ] }
                    ]
                },
                "TargetValidators": [
                    {
                        "refkeys": [ "worker" ],
                        "baseScope": "CurrentTarget",
                        "chara_conditions": [
                            { "parameters": [ "exists" ] },
                            { "parameters": [ "excludePlayer" ] },
                            { "parameters": [ "sharesHomeFaction" ] },
                            { "parameters": [ "canArrangeJoinByTag", "memberType_work_fullTime" ] }
                        ],
                        "minTargetCount": 1
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "_comment": "Join or leave: holding a full-time post with leave options -> leave branch, else join.",
                        "options": [
                            {
                                "option": "_held",
                                "Results": [
                                    { "Type": "LeaveHeldFactionsByTag", "arguments": [ "leaveOptions", "worker", "memberType_work_fullTime", "heldMemberships" ] },
                                    { "Type": "ExistStoredOptions", "arguments": [ "leaveOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "leave_ask" ] }
                                ]
                            },
                            {
                                "option": "_join",
                                "Results": [
                                    { "Type": "JoinReachableFactionsByTag", "arguments": [ "arrangeOptions", "worker", "memberType_work_fullTime" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_ask" ] }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "leave_ask",
                        "_comment": "Picking a loaded leave option runs its leave callback, then (loadOptionsResults) goes on to rejoin.",
                        "UISpec": { "portraitRefKey": "worker" },
                        "question": "Opt_ArrangeJoin_WorkFullTime_leave_question",
                        "loadOptionsKey": "leaveOptions",
                        "loadOptionsResults": [ { "Type": "JumpToLabel", "arguments": [ "", "rejoin" ] } ],
                        "options": [
                            {
                                "option": "Opt_ArrangeJoin_Work_leave_cancel",
                                "isDefaultCancel": true,
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "arrange_cancel" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Branch, Assembly-CSharp",
                        "label": "rejoin",
                        "_comment": "After quitting: rebuild the job options. None (e.g. nothing reachable right now) -> end; the player can run the option again.",
                        "options": [
                            {
                                "option": "_has_options",
                                "Results": [
                                    { "Type": "JoinReachableFactionsByTag", "arguments": [ "arrangeOptions", "worker", "memberType_work_fullTime" ] },
                                    { "Type": "ExistStoredOptions", "arguments": [ "arrangeOptions" ] },
                                    { "Type": "JumpToLabel", "arguments": [ "", "arrange_ask" ] }
                                ]
                            },
                            {
                                "option": "_no_options",
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "arrange_cancel" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "arrange_ask",
                        "UISpec": { "portraitRefKey": "worker" },
                        "question": "Opt_ArrangeJoin_WorkFullTime_question",
                        "loadOptionsKey": "arrangeOptions",
                        "loadOptionsResults": [ { "Type": "JumpToLabel", "arguments": [ "", "arrange_done" ] } ],
                        "options": [
                            {
                                "option": "Opt_ArrangeJoin_cancel",
                                "isDefaultCancel": true,
                                "Results": [ { "Type": "JumpToLabel", "arguments": [ "", "arrange_cancel" ] } ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "arrange_done",
                        "_comment": "Reached by picking a loaded option (the question's loadOptionsResults jump here).",
                        "UISpec": { "portraitRefKey": "worker" },
                        "line": "Opt_ArrangeJoin_Work_done"
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "_comment": "What the picked option's join callback changed (AppendFactionChange: who is now what).",
                        "line": "$factionChangeString$",
                        "isLast": true
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "arrange_cancel",
                        "line": "",
                        "isLast": true
                    }
                ]
            }
        ]
    },
    "Dictionary": {
        "Entries": {
            "zh-cn": {
                "Opt_ArrangeJoin_WorkFullTime": "安排全职工作",
                "Opt_ArrangeJoin_WorkFullTime_question": "要让$worker.name$去哪里做全职工作？",
                "Opt_ArrangeJoin_WorkFullTime_leave_question": "$worker.name$已经是$heldMemberships$了。要让$worker.name$辞职吗？"
            }
        }
    }
}

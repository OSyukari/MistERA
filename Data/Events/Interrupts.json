{
    "Events": {
        "list": [
            {
                "ID": "OnEnterRoom_interrupt",
                "trigger": "OnEnterRoom",
                "_comment": "Keep Moving sets a 5 min cooldown for self with these targets only; targets still on it are dropped from the validator, so newcomers in the room still trigger",
                "cooldownTime": 5,
                "cooldownRestrictSelf": true,
                "cooldownRestrictTarget": true,
                "cooldownRestrictAND": true,
                "manualCooldown": true,
                "SelfValidator": {
                    "chara_conditions": [
                        {
                            "parameters": [
                                "isPlayer"
                            ]
                        },
                        {
                            "parameters": [
                                "hasActionPackageType",
                                "ActionPackage_PathTo",
                                "true",
                                "false"
                            ]
                        }
                    ]
                },
                "TargetValidators": [
                    {
                        "refkeys": [
                            "targets"
                        ],
                        "baseScope": "AllCharaInSelfRoom_ExcludeSelf",
                        "minTargetCount": 1,
                        "chara_conditions": [
                            { "parameters": [ "isOnEventCooldownWithSelf", "OnEnterRoom_interrupt", "false" ] }
                        ]
                    }
                ],
                "events": [
                    {
                        "$type": "Event+EventEntry+EventEntry_Question, Assembly-CSharp",
                        "label": "interruptSelf",
                        "UISpec": {
                            "portraitRefKey": "targets"
                        },
                        "question": "event_OnEnterRoom_interrupt_ev01",
                        "options": [
                            {
                                "option": "event_OnEnterRoom_interrupt_ev01_op1",
                                "isDefaultCancel": true,
                                "Results": [
                                    { "Type": "AddCooldown", "arguments": [ "OnEnterRoom_interrupt", "self", "targets" ] }
                                ]
                            },
                            {
                                "option": "event_OnEnterRoom_interrupt_ev01_op2",
                                "Results": [
                                    {
                                        "Type": "InterruptAP",
                                        "arguments": [
                                            "self",
                                            "false",
                                            "ActionPackage_PathTo"
                                        ]
                                    },
                                    {
                                        "Type": "JumpToLabel",
                                        "arguments": [
                                            "",
                                            "end"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "$type": "Event+EventEntry+EventEntry_Line, Assembly-CSharp",
                        "label": "end",
                        "isLast": true,
                        "line": "event_OnEnterRoom_interrupt_ev02"
                    }
                ]
            }
        ]
    },
    "Dictionary": {
        "Entries": {
            "zh-cn": {
                "event_OnEnterRoom_interrupt_ev01": "在$self.room_name$遇到了$targets.name$",
                "event_OnEnterRoom_interrupt_ev01_op1": "继续移动",
                "event_OnEnterRoom_interrupt_ev01_op2": "在此停下",
                "event_OnEnterRoom_interrupt_ev02": "$self.name$停下了脚步",
                "event_OnEnterRoom_interrupt_ev01_op2_tooltip": "将中断当前未处理完毕的移动指令",
                "event_isDefaultCancel_tooltip": "在当前界面的任意非按钮处按右键时也会自动选择该选项"
            },
            "en-us": {
                "event_OnEnterRoom_interrupt_ev01": "$targets.name$ are in $self.room_name$",
                "event_OnEnterRoom_interrupt_ev01_op1": "Keep Moving",
                "event_OnEnterRoom_interrupt_ev01_op2": "Stop Here",
                "event_OnEnterRoom_interrupt_ev02": "$self.name$ stops moving.",
                "event_OnEnterRoom_interrupt_ev01_op2_tooltip": "Will interrupt all remaining movement commands",
                "event_isDefaultCancel_tooltip": "This is the default option selected when Right click on anywhere else."
            }
        }
    }
}
